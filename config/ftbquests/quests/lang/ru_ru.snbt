	"quest.7200000100000001.quest_desc": [
		"Каждый мир начинается с маленького выбора. Собери первые ресурсы и найди свой путь.",
		"Творческая цель: отметь выполнение вручную, когда собственный проект готов.",
		"Отметь находку на карте мастерской."
	],
	"quest.7200000100000001.title": "Начало главы",
	"quest.7200000100000002.quest_desc": [
		"Каждый мир начинается с маленького выбора. Собери первые ресурсы и найди свой путь.",
		"Получи указанный предмет; FTB Quests не будет его расходовать.",
		"Преврати знание в небольшой практический опыт."
	],
