{
	"chapter.7100000100000000.chapter_subtitle": [
		"Каждый мир начинается с маленького выбора. Собери первые ресурсы и найди свой путь.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000100000000.title": "Первая искра",
	"chapter.7100000200000000.chapter_subtitle": [
		"Выживание превращается в уютный дом. Здесь каждая вещь работает на тебя.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000200000000.title": "Живая усадьба",
	"chapter.7100000300000000.chapter_subtitle": [
		"В глубине найдётся всё, что необходимо для будущих фабрик.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000300000000.title": "Под толщей камня",
	"chapter.7100000400000000.chapter_subtitle": [
		"Без хозяйства не построить ни одной большой фабрики.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000400000000.title": "Поле и очаг",
	"chapter.7100000500000000.chapter_subtitle": [
		"Строй с фантазией: каждый материал открывает новый стиль.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000500000000.title": "Город одного мастера",
	"chapter.7100000600000000.chapter_subtitle": [
		"Следуй за природой: каждый биом оставляет свою историю.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000600000000.title": "Дикий компас",
	"chapter.7100000700000000.chapter_subtitle": [
		"Прежде чем создавать фабрики, научись управлять импульсами.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000700000000.title": "Пробуждение редстоуна",
	"chapter.7100000800000000.chapter_subtitle": [
		"Океаны скрывают сокровища и древние технологии.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000800000000.title": "Глубинный атлас",
	"chapter.7100000900000000.chapter_subtitle": [
		"Наука и магия здесь говорят на одном языке.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000900000000.title": "Тайная лаборатория",
	"chapter.7100000A00000000.chapter_subtitle": [
		"По ту сторону портала жар превращается в ресурс.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000A00000000.title": "Сквозь пламя",
	"chapter.7100000B00000000.chapter_subtitle": [
		"Там, где заканчивается небо, начинается последняя экспедиция.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000B00000000.title": "За горизонтом",
	"chapter.7100000C00000000.chapter_subtitle": [
		"Механика начинается с осей, шестерён и вращения.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000C00000000.title": "Create: Первые механизмы",
	"chapter.7100000D00000000.chapter_subtitle": [
		"Построй устройства, которые двигают целые сооружения.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000D00000000.title": "Create: Живые конструкции",
	"chapter.7100000E00000000.chapter_subtitle": [
		"От латуни до автоматики: фабрика должна жить самостоятельно.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000E00000000.title": "Create: Великая фабрика",
	"chapter.7100000F00000000.chapter_subtitle": [
		"Построй торговый центр и познакомься с ремёслами жителей.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100000F00000000.title": "Торговый город",
	"chapter.7100001000000000.chapter_subtitle": [
		"Исследуй забытые места и восстанови историю по осколкам.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001000000000.title": "Пыль и реликвии",
	"chapter.7100001100000000.chapter_subtitle": [
		"Открой древние тайны пещер: в тишине слышно больше.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001100000000.title": "Тихие глубины",
	"chapter.7100001200000000.chapter_subtitle": [
		"Составь путеводитель по самым удивительным местам мира.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001200000000.title": "Атлас горизонтов",
	"chapter.7100001300000000.chapter_subtitle": [
		"Поднимись к облакам и сделай небо частью своего дома.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001300000000.title": "Выше облаков",
	"chapter.7100001400000000.chapter_subtitle": [
		"Автоматизируй сортировку, доставку и хранение предметов.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001400000000.title": "Create: Сортировочные сети",
	"chapter.7100001500000000.chapter_subtitle": [
		"Построй железнодорожную сеть, связывающую мастерские.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001500000000.title": "Create: Железные дороги",
	"chapter.7100001600000000.chapter_subtitle": [
		"Управляй теплом, водой и вращением в большой паровой станции.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
	],
	"chapter.7100001600000000.title": "Create: Эпоха пара",
	"chapter.7100001700000000.chapter_subtitle": [
		"Собери механизмы, которые действительно выполняют работу.",
		"Разветвлённая карта заданий: изучай маршруты в любом порядке и открывай финальную печать."
