{
	chapter.000000000000C001.chapter_subtitle: ["От голых рук до полного комплекта железных инструментов.", "Все квесты этой главы используют только ванильные предметы."],
	chapter.000000000000C001.title: "Начало",
	chapter.000000000000C002.chapter_subtitle: ["Стабильная еда означает, что ты перестанешь умирать от голода посреди вылазки."],
	chapter.000000000000C002.title: "Еда и ферма",
	chapter.000000000000C003.chapter_subtitle: ["Пещеры, Нижний мир, Крепость и Край."],
	chapter.000000000000C003.title: "Исследование",
	chapter.000000000000C004.chapter_subtitle: ["Этих предметов нет в ванили — их регистрирует KubeJS из скриптов в папке kubejs/.", "Если рецепты ниже не появились, проверь загрузку kubejs/startup_scripts и загляни в logs/kubejs/."],
	chapter.000000000000C004.title: "Кастомный контент",
	quest.0000000000001110.quest_desc: ["Ударь дерево рукой и собери 8 дубовых брёвен. Для крафта подойдёт любая древесина, но этот квест просит именно дуб."],
	quest.0000000000001110.title: "Первое дерево",
	quest.0000000000001120.quest_desc: ["Скрафти верстак из 4 досок. Всё остальное начинается здесь."],
	quest.0000000000001120.title: "Верстак",
	quest.0000000000001130.quest_desc: ["Скрафти деревянную кирку: 3 доски + 2 палки.", "Без неё нельзя добыть булыжник."],
	quest.0000000000001130.title: "Деревянная кирка",
	quest.0000000000001140.quest_desc: ["Добудь 32 булыжника и перейди на каменную кирку.", "Каменные инструменты служат вдвое дольше деревянных."],
	quest.0000000000001140.title: "Каменный век",
	quest.0000000000001150.quest_desc: ["Выплавь 8 железных слитков. Железную руду нужно копать каменной киркой или лучше — деревянная уничтожает дроп."],
	quest.0000000000001150.title: "Железо",
	quest.0000000000001160.quest_desc: ["Скрафти полный комплект железных инструментов и щит."],
	quest.0000000000001160.title: "Полный комплект",
	quest.0000000000001210.quest_desc: ["Вырасти пшеницу и испеки 6 хлеба. Семена выпадают из высокой травы."],
	quest.0000000000001210.title: "Хлеб насущный",
	quest.0000000000001220.quest_desc: ["С коров падает кожа; свиней и кур тоже стоит разводить. Кожа нужна для книг и рам."],
	quest.0000000000001220.title: "Животноводство",
	quest.0000000000001230.quest_desc: ["Морковь и картофель падают с зомби или берутся на фермах в деревнях. Золотая морковь — лучшая еда по насыщению."],
	quest.0000000000001230.title: "Огород",
	quest.0000000000001240.quest_desc: ["Скрафти удочку и поймай что-нибудь. Рыбалка также даёт зачарованные книги и сёдла в качестве сокровищ."],
	quest.0000000000001240.title: "Рыбалка",
	quest.0000000000001310.quest_desc: ["Алмазы встречаются ниже Y=16, чаще всего около Y=-59. Возьми факелы, еду и ведро воды."],
	quest.0000000000001310.title: "В глубины",
	quest.0000000000001320.quest_desc: ["Вылей воду на озеро лавы. Чтобы добыть обсидиан, нужна алмазная кирка."],
	quest.0000000000001320.title: "Обсидиан",
	quest.0000000000001330.quest_desc: ["Построй рамку 4x5 из обсидиана, подожги и вступи в портал. Один блок в Нижнем мире равен восьми в Верхнем."],
	quest.0000000000001330.title: "Нижний мир",
	quest.0000000000001340.quest_desc: ["Найди крепость Нижнего мира и убей ифритов. Стержни нужны для очей Края и для зельеварения."],
	quest.0000000000001340.title: "Огненные стержни",
	quest.0000000000001350.quest_desc: ["Скрафти очи Края и бросай их, чтобы найти Крепость. Возьми кирку и метку-кровать."],
	quest.0000000000001350.title: "Крепость",
	quest.0000000000001360.quest_desc: ["Войди в портал Края и победи Дракона Края. Сначала уничтожь кристаллы на столбах."],
	quest.0000000000001360.title: "Край",
	quest.0000000000001410.quest_desc: ["Скрафти Медаль квеста: 1 алмаз + 1 золотой слиток + 1 изумруд, бесформенный рецепт.", "Этот предмет регистрируется KubeJS в kubejs/startup_scripts/custom_items.js."],
	quest.0000000000001410.title: "Медаль квеста",
	quest.0000000000001420.quest_desc: ["Улучши медаль форменным рецептом: 3 незеритовых обломка сверху, медаль в центре, 3 золота снизу."],
	quest.0000000000001420.title: "Улучшенная медаль",
	quest.0000000000001430.quest_desc: ["Финальный кастомный предмет. Его рецепт регистрируется из kubejs/server_scripts/recipes.js и требует звезду Нижнего мира.", "Получение означает, что ты одолел Иссушителя."],
	quest.0000000000001430.title: "Мастер квестов"
}
