{
	"chapter.7100000100000000.chapter_subtitle": [
		"Every world begins with a small decision. Gather, adapt, build.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000100000000.title": "The First Spark",
	"chapter.7100000200000000.chapter_subtitle": [
		"Turn survival into a home. Craft workstations and make a place worth returning to.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000200000000.title": "The Living Homestead",
	"chapter.7100000300000000.chapter_subtitle": [
		"Go deeper. The ground hides everything your future factories need.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000300000000.title": "Beneath the Stone",
	"chapter.7100000400000000.chapter_subtitle": [
		"You cannot build great machines on an empty stomach.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000400000000.title": "Harvest and Hearth",
	"chapter.7100000500000000.chapter_subtitle": [
		"Build with care. Every material is a new design language.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000500000000.title": "City of One",
	"chapter.7100000600000000.chapter_subtitle": [
		"Let nature become your guide. Explore the living world.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000600000000.title": "The Wild Compass",
	"chapter.7100000700000000.chapter_subtitle": [
		"Before industry comes logic. Route power with dust, pulses and pistons.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000700000000.title": "Redstone Awakening",
	"chapter.7100000800000000.chapter_subtitle": [
		"The seas conceal rare treasures and ancient technology.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000800000000.title": "The Deep Atlas",
	"chapter.7100000900000000.chapter_subtitle": [
		"Learn what glows, brews, enchants and transforms.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000900000000.title": "The Arcane Workshop",
	"chapter.7100000A00000000.chapter_subtitle": [
		"Behind the portal, heat becomes a resource.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000A00000000.title": "Through the Fire",
	"chapter.7100000B00000000.chapter_subtitle": [
		"Reach the quiet dimension and bring its stories home.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000B00000000.title": "Beyond the Horizon",
	"chapter.7100000C00000000.chapter_subtitle": [
		"Power has shape: shafts, gears and rotations. Build your first workshop.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000C00000000.title": "Create: Foundations",
	"chapter.7100000D00000000.chapter_subtitle": [
		"Make motion meaningful. Turn simple gears into moving structures.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000D00000000.title": "Create: Moving Cities",
	"chapter.7100000E00000000.chapter_subtitle": [
		"From brass to automation. Design a factory with a mind of its own.",
		"Three routes. Complete all three to unlock the final seal. No item consumption."
	],
	"chapter.7100000E00000000.title": "Create: The Grand Factory",
