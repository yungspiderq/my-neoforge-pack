{
	chapter.000000000000C001.chapter_subtitle: ["From bare hands to a full set of iron gear.", "Every quest here uses only vanilla items."],
	chapter.000000000000C001.title: "Getting Started",
	chapter.000000000000C002.chapter_subtitle: ["A stable food supply means you stop dying to hunger mid-expedition."],
	chapter.000000000000C002.title: "Food and Farming",
	chapter.000000000000C003.chapter_subtitle: ["Caves, the Nether, the Stronghold and the End."],
	chapter.000000000000C003.title: "Exploration",
	chapter.000000000000C004.chapter_subtitle: ["These items do not exist in vanilla — they are registered by KubeJS from the scripts in kubejs/.", "If the recipes below do not appear, check kubejs/startup_scripts loaded and look at logs/kubejs/."],
	chapter.000000000000C004.title: "Custom Content",
	quest.0000000000001110.quest_desc: ["Punch a tree and collect 8 oak logs. Any log type counts for crafting, but this quest specifically asks for oak."],
	quest.0000000000001110.title: "First Wood",
	quest.0000000000001120.quest_desc: ["Craft a crafting table from 4 planks. Everything else starts here."],
	quest.0000000000001120.title: "Workbench",
	quest.0000000000001130.quest_desc: ["Craft a wooden pickaxe: 3 planks + 2 sticks.", "Without it you cannot get cobblestone."],
	quest.0000000000001130.title: "Wooden Pickaxe",
	quest.0000000000001140.quest_desc: ["Mine 32 cobblestone and upgrade to a stone pickaxe.", "Stone tools last more than twice as long as wooden ones."],
	quest.0000000000001140.title: "Stone Age",
	quest.0000000000001150.quest_desc: ["Smelt 8 iron ingots. Iron ore needs a stone pickaxe or better — a wooden one destroys the drop."],
	quest.0000000000001150.title: "Iron",
	quest.0000000000001160.quest_desc: ["Craft a full set of iron gear plus a shield."],
	quest.0000000000001160.title: "Fully Equipped",
	quest.0000000000001210.quest_desc: ["Grow wheat and bake 6 bread. Tall grass drops wheat seeds."],
	quest.0000000000001210.title: "Daily Bread",
	quest.0000000000001220.quest_desc: ["Cows drop leather; pigs and chickens are worth breeding too. Leather is needed for books and item frames."],
	quest.0000000000001220.title: "Animal Husbandry",
	quest.0000000000001230.quest_desc: ["Carrots and potatoes come from zombie drops or village farms. Golden carrots are the best saturation food in the game."],
	quest.0000000000001230.title: "Kitchen Garden",
	quest.0000000000001240.quest_desc: ["Craft a fishing rod and catch something. Fishing also drops enchanted books and saddles as treasure."],
	quest.0000000000001240.title: "Gone Fishing",
	quest.0000000000001310.quest_desc: ["Diamonds spawn below Y=16, most commonly around Y=-59. Bring torches, food and a water bucket."],
	quest.0000000000001310.title: "Into the Depths",
	quest.0000000000001320.quest_desc: ["Pour water over a lava pool. A diamond pickaxe is required to mine obsidian."],
	quest.0000000000001320.title: "Obsidian",
	quest.0000000000001330.quest_desc: ["Build a 4x5 obsidian frame, light it and step through. One block in the Nether equals eight in the Overworld."],
	quest.0000000000001330.title: "The Nether",
	quest.0000000000001340.quest_desc: ["Find a Nether Fortress and kill blazes. Rods are needed for eyes of ender and for brewing."],
	quest.0000000000001340.title: "Blaze Rods",
	quest.0000000000001350.quest_desc: ["Craft eyes of ender and throw them to triangulate the Stronghold. Bring a pickaxe and a bed marker."],
	quest.0000000000001350.title: "The Stronghold",
	quest.0000000000001360.quest_desc: ["Enter the End portal and defeat the Ender Dragon. Destroy the crystals on the pillars first."],
	quest.0000000000001360.title: "The End",
	quest.0000000000001410.quest_desc: ["Craft a Quest Token: 1 diamond + 1 gold ingot + 1 emerald, shapeless.", "This item is registered by KubeJS at kubejs/startup_scripts/custom_items.js."],
	quest.0000000000001410.title: "Quest Token",
	quest.0000000000001420.quest_desc: ["Upgrade the token in a shaped recipe: 3 netherite scrap across the top, token in the middle, 3 gold below."],
	quest.0000000000001420.title: "Premium Token",
	quest.0000000000001430.quest_desc: ["The final custom item. Its recipe is registered from kubejs/server_scripts/recipes.js and requires a Nether Star.", "Earning one means you have finished the Wither."],
	quest.0000000000001430.title: "Master of Quests"
}
