{
	chapter.000000000000C001.chapter_subtitle: ["The sun has not risen for three days. A star burns where no star should be, and its light is calling you.", "A story-driven prologue: read it, take the shard and follow the road through the Dawnlands, the Crimson Hells, the Edge of the Void and into the Eternal Starlight."],
	chapter.000000000000C001.title: "The Dying Star",
	chapter.000000000000C002.chapter_subtitle: ["One world, one life, one book. Everything you need is under your feet.", "Sections are read left to right, top to bottom; the arrows show what unlocks what."],
	chapter.000000000000C002.title: "Dawnlands",
	chapter.000000000000C003.chapter_subtitle: ["No water, no sleep, no sky. Everything here burns or wants to burn you.", "Get in through the portal from the Dawnlands, get out through the stronghold."],
	chapter.000000000000C003.title: "The Crimson Furnace",
	chapter.000000000000C004.chapter_subtitle: ["Nothing grows here and nothing forgives a mistake. Only islands, dragons and loot.", "The last chapter: the dragon, the wings and the medal of the pack."],
	chapter.000000000000C004.title: "Edge of the Void",
	chapter.000000000000C005.chapter_subtitle: ["The Eternal Starlight mod: the Starlight dimension, 24 biomes, 8 structures, two bosses, nine gear tiers and over a thousand blocks and items.", "Small quests, one step each: the whole mod is covered, not a single item is lost."],
	chapter.000000000000C005.title: "The Eternal Starlight",
	image.0000000000401002.title: "The Last Night",
	image.0000000000401004.title: "The Call",
	image.0000000000401006.title: "The Road",
	image.000000000040100B.title: "Three days without dawn",
	image.000000000040100C.title: "To the Dawnlands",
	image.000000000040100D.title: "To the Nether",
	image.000000000040100E.title: "To the End",
	image.000000000040100F.title: "To the Eternal Starlight",
	image.0000000000402002.title: "Awakening",
	image.0000000000402004.title: "Under the Ground",
	image.0000000000402006.title: "Wild Lands",
	image.0000000000402008.title: "Farm and Food",
	image.000000000040200A.title: "Steel and Fang",
	image.000000000040200C.title: "Enchanting",
	image.000000000040200E.title: "Contraptions",
	image.0000000000402010.title: "The Gate",
	image.0000000000402016.title: "To the Nether",
	image.0000000000402017.title: "XP is consumed!",
	image.0000000000402018.title: "Sneak. Do not run.",
	image.0000000000403002.title: "Arrival",
	image.0000000000403004.title: "The Fortress",
	image.0000000000403006.title: "Gold and Swine",
	image.0000000000403008.title: "Black Gold",
	image.000000000040300A.title: "Lords of Hell",
	image.000000000040300C.title: "Way Back Up",
	image.0000000000403012.title: "Boss. Prepare first.",
	image.0000000000403013.title: "Y = 15, dig sideways",
	image.0000000000403014.title: "To the End",
	image.0000000000404002.title: "The Fall",
	image.0000000000404004.title: "Outer Islands",
	image.0000000000404006.title: "City of the End",
	image.0000000000404008.title: "Pack Master",
	image.000000000040400E.title: "Piston, not a pickaxe",
	image.000000000040400F.title: "Throw a pearl in",
	image.0000000000404010.title: "Thank you for playing",
	image.0000000000405002.title: "The Road to the Starlight",
	image.0000000000405004.title: "The Bestiary",
	image.0000000000405006.title: "Ores and Materials",
	image.0000000000405008.title: "The Arsenal: Nine Tiers",
	image.000000000040500A.title: "Unique Blades",
	image.000000000040500C.title: "Arrows and a Quiver",
	image.000000000040500E.title: "The Raiment",
	image.0000000000405010.title: "Table and Pocket",
	image.0000000000405012.title: "Pearls and Finale",
	image.0000000000405014.title: "The orb opens in your hands",
	image.0000000000405015.title: "A bowl of stew = a day of service",
	image.0000000000405017.title: "It is a trial, not a brawl",
	image.0000000000405019.title: "Ignite it - else immortal",
	image.000000000040501A.title: "Deactivate the energy block first",
	quest.0000000000101010.quest_desc: ["You wake on the cold stone of the observatory. The night has lasted three days. The sun is gone, and in its place a star burns low over the horizon — a star that was never in any of your charts.", "The book on the lectern is open. Its first page is blank except for one line in your own hand: «When the star goes out, follow its light»."],
	quest.0000000000101010.title: "The Last Night",
	quest.0000000000101020.quest_desc: ["Something fell into the courtyard last night. The shard is still warm, and the light inside it does not go out when you cover it with your hand.", "It is not amethyst. Amethyst does not whisper."],
	quest.0000000000101020.title: "The Shard",
	quest.0000000000101030.quest_desc: ["The observatory remembers you. The telescope is intact, the charts are scattered across the floor, and the brass rings still turn.", "Through the lens the dying star has a shape: a gate, not a sun."],
	quest.0000000000101030.title: "The Observatory",
	quest.0000000000101040.quest_desc: ["The chart points to the Dawnlands: the first hills, the first trees, the old road under them. That is where the light fell first.", "Draw a fresh map and take paper with you. The road will not stay still."],
	quest.0000000000101040.title: "The Star Chart",
	quest.0000000000101050.quest_desc: ["An ordinary lantern will do for the dark. But keep the shard close: it shows the traces of starlight that no eye can see.", "Later, when you find starfire and a starlit diamond, you will build a proper Stargazer's Lantern."],
	quest.0000000000101050.title: "The Stargazer's Lantern",
	quest.0000000000101060.quest_desc: ["The first tree is the beginning of everything. Wood, a bench, a pickaxe — the old road is buried under ordinary survival.", "Open the Dawnlands chapter and start with the first log. The book will guide you further."],
	quest.0000000000101060.title: "The Road Begins",
	quest.0000000000101070.quest_desc: ["The second shard fell into the Nether. The light there does not warm — it tests. Build the obsidian gate and step through.", "The Crimson Hells chapter will take you from the first netherrack to the fortress and the End portal."],
	quest.0000000000101070.title: "The Call of Fire",
	quest.0000000000101080.quest_desc: ["The End is not the end. It is a seal. The dragon guards the first door, and beyond it the void remembers the star's true name.", "Defeat the dragon, find the gateway and follow the outer islands."],
	quest.0000000000101080.title: "The Call of the Void",
	quest.0000000000101090.quest_desc: ["When the dragon falls, the sky opens. The Eternal Starlight is the star's own world: light turned into land, forests and seas, nine lights and two guardians.", "Find the Orb of Prophecy. It will show you the way to the Gatekeeper and the Moon Beast — and to the heart of the dying star."],
	quest.0000000000101090.title: "The Call of Starlight",
	quest.0000000000102010.quest_desc: ["Hold the left mouse button on a tree trunk. Sixteen logs is enough to start; the rest you will get from saplings.", "Everything in this book starts here.", "Any wood counts - oak, spruce, even Starlight timber: the counter accepts whatever logs you carry."],
	quest.0000000000102010.title: "First Wood",
	quest.0000000000102020.quest_desc: ["Planks in the inventory crafting grid, then four planks into a table. From now on 3x3 recipes are available. Any planks count (one stack of 32)."],
	quest.0000000000102020.title: "Workbench",
	quest.0000000000102030.quest_desc: ["A wooden pickaxe digs stone, a wooden axe chops twice as fast. They break quickly — that is normal."],
	quest.0000000000102030.title: "Wooden Set",
	quest.0000000000102040.title: "Stone Age",
	quest.0000000000102050.quest_desc: ["Coal from a vein or from a charcoal kiln: put logs on top, fuel underneath. Interact with the furnace at least once."],
	quest.0000000000102050.title: "Furnace",
	quest.0000000000102060.quest_desc: ["A door stops zombies, a chest stores the loot, a ladder gets you out of the hole. The house can be a hole in a hill."],
	quest.0000000000102060.title: "Four Walls",
	quest.0000000000102070.quest_desc: ["Three wool and three planks. Sleeping skips the night and moves the spawn point — you will not walk back across the map after dying. Any bed colour counts."],
	quest.0000000000102070.title: "Good Night",
	quest.0000000000102080.quest_desc: ["Mobs spawn where the light level is zero. Torches are the cheapest way to keep your house and your mine empty."],
	quest.0000000000102080.title: "Light in the Dark",
	quest.0000000000102090.quest_desc: ["Raw iron is smelted in a furnace. Eight ingots is a full set of tools and a bucket."],
	quest.0000000000102090.title: "Iron Age",
	quest.00000000001020A0.quest_desc: ["Sword, pickaxe, axe, shovel and a shield. The shield blocks arrows and creeper explosions — hold it in the off-hand and crouch."],
	quest.00000000001020A0.title: "Full Kit",
	quest.00000000001020B0.title: "Armor",
	quest.00000000001020C0.quest_desc: ["Water turns lava into obsidian, lava melts sand into glass. A bucket is the most useful tool after the pickaxe."],
	quest.00000000001020C0.title: "Bucket",
	quest.00000000001020D0.quest_desc: ["Below Y=0 stone turns into deepslate. Dig a staircase, not a shaft: you cannot jump out of a 1x1 hole."],
	quest.00000000001020D0.title: "Down We Go",
	quest.00000000001020E0.title: "Black Gold",
	quest.00000000001020F0.quest_desc: ["Copper is needed for a lightning rod, a spyglass and the copper bulb. It oxidises, but that is only cosmetic."],
	quest.00000000001020F0.title: "Copper",
	quest.0000000000102100.title: "Red Dust",
	quest.0000000000102110.quest_desc: ["Save it: enchanting consumes lapis by the handful."],
	quest.0000000000102110.title: "Lapis Lazuli",
	quest.0000000000102120.title: "Gold",
	quest.0000000000102130.quest_desc: ["Best height is Y=-59, and always dig sideways with a two-block ceiling. Five diamonds: a pickaxe plus two spares."],
	quest.0000000000102130.title: "Diamonds!",
	quest.0000000000102140.quest_desc: ["Get down to Y=-60. Bedrock is at -64, lava oceans are between. Take a water bucket."],
	quest.0000000000102140.title: "Bottom of the World",
	quest.0000000000102150.quest_desc: ["A dark sphere of smooth basalt hides amethyst. Listen: the blocks chime when you walk on them."],
	quest.0000000000102150.title: "Amethyst Geode",
	quest.0000000000102160.quest_desc: ["Emerald ore only generates under mountains. Villagers will pay for everything else anyway."],
	quest.0000000000102160.title: "Emeralds",
	quest.0000000000102170.quest_desc: ["Dripstone caves stab you from above, lush caves glow with berries. Both are worth a look."],
	quest.0000000000102170.title: "Crystal and Moss",
	quest.0000000000102180.quest_desc: ["Sculk hears you. Sneak, do not run, do not place blocks on the sensors. Wool muffles vibrations."],
	quest.0000000000102180.title: "Deep Dark",
	quest.0000000000102190.quest_desc: ["A huge dark structure under the deep dark. Chests hold the Swift Sneak book and the disc fragments. Do not break the portal frame."],
	quest.0000000000102190.title: "Ancient City",
	quest.00000000001021A0.quest_desc: ["Sneak within 8 blocks of a sculk sensor and stay alive. The Warden is not meant to be killed: it drops nothing."],
	quest.00000000001021A0.title: "Do Not Breathe",
	quest.00000000001021B0.quest_desc: ["A copper-and-tuff structure with vaults. A trial key opens a normal vault, an ominous key — the good ones."],
	quest.00000000001021B0.title: "Trial Chamber",
	quest.00000000001021C0.quest_desc: ["Pour water over a lava lake, then mine it with a diamond pickaxe. Fourteen blocks: ten for the portal, four for an enchanting table."],
	quest.00000000001021C0.title: "Obsidian",
	quest.00000000001021D0.quest_desc: ["The compass always points at the world spawn. Walk until the landscape stops repeating."],
	quest.00000000001021D0.title: "First Step Out",
	quest.00000000001021E0.quest_desc: ["Talk to a villager with the trade key (right-click). The librarian sells enchanted books for emeralds — find him first."],
	quest.00000000001021E0.title: "Village",
	quest.00000000001021F0.quest_desc: ["Five trades of any kind. Trading also refreshes the villager's stock."],
	quest.00000000001021F0.title: "Merchant",
	quest.0000000000102200.quest_desc: ["A dark oak tower with cages. Killing the captain gives Bad Omen — do not walk into a village with it."],
	quest.0000000000102200.title: "Pillager Outpost",
	quest.0000000000102210.quest_desc: ["Bring Bad Omen into a village and survive all waves. Vindicators and a ravager come at the end."],
	quest.0000000000102210.title: "Hero of the Village",
	quest.0000000000102220.quest_desc: ["Desert, taiga, jungle, swamp and savanna. Biomes count when you stand in them, the map is not enough."],
	quest.0000000000102220.title: "Five Lands",
	quest.0000000000102230.title: "To the Sea",
	quest.0000000000102240.quest_desc: ["Guardians do not let you mine. Drink a water-breathing potion or drain the monument; the elder guardian is inside."],
	quest.0000000000102240.title: "Ocean Monument",
	quest.0000000000102250.quest_desc: ["A map from a wreck leads to buried treasure: dig where the red cross is. The heart of the sea is inside."],
	quest.0000000000102250.title: "Shipwreck",
	quest.0000000000102260.quest_desc: ["Goats drop a horn when they ram a block. Snowy slopes and stony peaks are where to look."],
	quest.0000000000102260.title: "Peaks",
	quest.0000000000102270.quest_desc: ["Pink trees on top of mountains. Petals fall from the leaves."],
	quest.0000000000102270.title: "Cherry Grove",
	quest.0000000000102280.quest_desc: ["A cartographer villager sells the map. Inside: evokers, and every one of them drops a totem."],
	quest.0000000000102280.title: "Woodland Mansion",
	quest.0000000000102290.quest_desc: ["Bones for a wolf, fish for a cat, a saddle for a horse. A tamed animal follows you and can be healed with meat."],
	quest.0000000000102290.title: "Companions",
	quest.00000000001022A0.quest_desc: ["Break tall grass for seeds, hoe the dirt next to water and plant. Bone meal speeds everything up."],
	quest.00000000001022A0.title: "Seeds",
	quest.00000000001022B0.title: "Bread",
	quest.00000000001022C0.quest_desc: ["Carrots and potatoes come from village farms and zombies. Beetroot is fast but not very filling."],
	quest.00000000001022C0.title: "Kitchen Garden",
	quest.00000000001022D0.quest_desc: ["Feed two animals of the same kind their favourite food and they will produce a baby. Ten of any kind counts."],
	quest.00000000001022D0.title: "Breeding",
	quest.00000000001022E0.title: "Full Yard",
	quest.00000000001022F0.quest_desc: ["Shears do not hurt the sheep and regrow after feeding. Dye changes the colour of the wool. Any wool colour counts."],
	quest.00000000001022F0.title: "Wool",
	quest.0000000000102300.quest_desc: ["Treasure comes from an open water surface at least 5x4x5. Enchant the rod with Luck of the Sea to get it faster."],
	quest.0000000000102300.title: "Fishing",
	quest.0000000000102310.quest_desc: ["Look at a bee nest for a few seconds — the task counts the glance. Shears give honeycomb, a bottle gives honey."],
	quest.0000000000102310.title: "Apiary",
	quest.0000000000102320.title: "Melon and Pumpkin",
	quest.0000000000102330.quest_desc: ["Eight nuggets around a carrot. The best saturation in the game — take a stack into the Nether."],
	quest.0000000000102330.title: "Golden Carrot",
	quest.0000000000102340.title: "Cake",
	quest.0000000000102350.quest_desc: ["Eat everything edible in the game, including pufferfish and spider eyes. Long, dull, and worth the achievement."],
	quest.0000000000102350.title: "Balanced Diet",
	quest.0000000000102360.quest_desc: ["Zombies burn in the sun and drop rotten flesh. Five of them is one night of standing your ground."],
	quest.0000000000102360.title: "First Blood",
	quest.0000000000102370.quest_desc: ["A skeleton shoots from 16 blocks. Use a shield and a corner, or dig down and hit from below."],
	quest.0000000000102370.title: "Bones",
	quest.0000000000102380.quest_desc: ["Cave spiders are smaller and poisonous, they live in abandoned mines wrapped in cobwebs."],
	quest.0000000000102380.title: "Eight Legs",
	quest.0000000000102390.quest_desc: ["Hit and step back, or lure a skeleton to kill it. Charged creepers spawn from lightning and drop heads."],
	quest.0000000000102390.title: "Do Not Hiss",
	quest.00000000001023A0.quest_desc: ["A fully drawn bow flies further. Hold the shield in the off-hand while shooting to survive the return fire."],
	quest.00000000001023A0.title: "Marksman",
	quest.00000000001023B0.quest_desc: ["Do not look at his face. Fight under a roof two blocks high — he cannot reach you there."],
	quest.00000000001023B0.title: "Tall Guest",
	quest.00000000001023C0.quest_desc: ["Slimes spawn in swamps at night and in slime chunks below Y=40. Big ones split into smaller ones."],
	quest.00000000001023C0.title: "Slime",
	quest.00000000001023D0.title: "Shield Wall",
	quest.00000000001023E0.quest_desc: ["250 kills of any mobs. Counted by the game statistic, not by this quest book."],
	quest.00000000001023E0.title: "Hunter",
	quest.00000000001023F0.quest_desc: ["Four iron blocks in a T and a carved pumpkin on top. He defends the village and you."],
	quest.00000000001023F0.title: "Iron Guardian",
	quest.0000000000102400.quest_desc: ["Kill one of every hostile mob in the game, including the Wither and the Ender Dragon. This is a season of play."],
	quest.0000000000102400.title: "Head Collection",
	quest.0000000000102410.quest_desc: ["Drowned carry tridents rarely; farms on the ocean work better. A trident with Loyalty returns to your hand."],
	quest.0000000000102410.title: "Trident",
	quest.0000000000102420.quest_desc: ["The task CONSUMES ten levels: experience is the currency of enchanting. Bottle it later, or grind mobs now."],
	quest.0000000000102420.title: "Experience",
	quest.0000000000102430.quest_desc: ["Four obsidian, two diamonds, one book. Look at the table for a couple of seconds to complete the observation task."],
	quest.0000000000102430.title: "Enchanting Table",
	quest.0000000000102440.quest_desc: ["Fifteen bookshelves one block away from the table unlock level 30 enchantments. Air must be between them."],
	quest.0000000000102440.title: "Library",
	quest.0000000000102450.quest_desc: ["Third slot, three levels of luck, and hope for Fortune or Silk Touch."],
	quest.0000000000102450.title: "First Enchantment",
	quest.0000000000102460.title: "Diamond Bar",
	quest.0000000000102470.quest_desc: ["Merges enchantments and repairs gear. Each use makes the next repair more expensive."],
	quest.0000000000102470.title: "Anvil",
	quest.0000000000102480.quest_desc: ["Three blaze rods and a nether wart make the base potion. Until then you can brew awkward potions from water bottles."],
	quest.0000000000102480.title: "Brewing Stand",
	quest.0000000000102490.quest_desc: ["A smithing table upgrades diamond gear to netherite, a grindstone strips enchantments and returns some experience."],
	quest.0000000000102490.title: "Smithing",
	quest.00000000001024A0.quest_desc: ["A custom item of this pack: a diamond, a gold ingot and an emerald in any arrangement. The recipe is in JEI.", "Tokens are collected, not used. The premium token needs netherite."],
	quest.00000000001024A0.title: "Quest Token",
	quest.00000000001024B0.quest_desc: ["A signal travels 15 blocks; a repeater refreshes it. A comparator reads the fullness of a chest."],
	quest.00000000001024B0.title: "Wiring",
	quest.00000000001024C0.title: "Pistons",
	quest.00000000001024D0.quest_desc: ["An observer sees a block change, a hopper moves items. Together they build every automatic farm."],
	quest.00000000001024D0.title: "Observers and Hoppers",
	quest.00000000001024E0.quest_desc: ["A powered rail needs gold and a redstone torch. Ride two kilometres to complete the statistic."],
	quest.00000000001024E0.title: "Railway",
	quest.00000000001024F0.quest_desc: ["Right-click tunes a note block, a record in a jukebox plays until it ends. Records drop from creepers killed by skeletons."],
	quest.00000000001024F0.title: "Music",
	quest.0000000000102500.quest_desc: ["Gunpowder and sand. Useful for digging down fast and for waking the whole neighbourhood."],
	quest.0000000000102500.title: "Boom",
	quest.0000000000102510.quest_desc: ["Build any automatic farm: iron, gold, crops or mob grinder. There is no item to hand in — tick the box yourself when it works."],
	quest.0000000000102510.title: "Own Contraption",
	quest.0000000000102520.quest_desc: ["Flint from gravel, iron ingot. It lights the portal and the TNT."],
	quest.0000000000102520.title: "Flint and Steel",
	quest.0000000000102530.quest_desc: ["One of three is enough: full iron armor, enchanted diamond gear or a brewing stand. The Nether does not care which one you chose."],
	quest.0000000000102530.title: "Pick Your Path",
	quest.0000000000102540.quest_desc: ["Ten obsidian minimum: a 4x5 frame without corners works. Light it with flint and steel and step in.", "One block in the Nether is eight blocks in the Overworld. That is how you travel fast."],
	quest.0000000000102540.title: "The Nether Gate",
	quest.0000000000103010.quest_desc: ["There is no night here, no rain and no safe place. Build a shelter around the portal before you walk away: ghasts break it easily.", "Coordinates here are one eighth of the Overworld ones."],
	quest.0000000000103010.title: "Step Into the Fire",
	quest.0000000000103020.quest_desc: ["Netherrack melts instantly and is the cheapest building material here. Do not build a house of it."],
	quest.0000000000103020.title: "Blood Stone",
	quest.0000000000103030.quest_desc: ["Nether quartz ore gives experience and clean white blocks. It is everywhere, just look down."],
	quest.0000000000103030.title: "Quartz",
	quest.0000000000103040.quest_desc: ["Hanging clusters under the ceiling. Break with Silk Touch to get whole blocks, otherwise dust."],
	quest.0000000000103040.title: "Glowstone",
	quest.0000000000103050.quest_desc: ["Wastes, crimson and warped forests, soul sand valley and basalt deltas. Each has its own mobs and sounds."],
	quest.0000000000103050.title: "Five Hells",
	quest.0000000000103060.quest_desc: ["Dark red brick corridors over the lava. Blazes, wither skeletons and nether wart grow here."],
	quest.0000000000103060.title: "Nether Fortress",
	quest.0000000000103070.quest_desc: ["A ghast fireball can be punched back with a bare hand or an arrow — that is how the achievement is earned. The tear is used in regeneration potions."],
	quest.0000000000103070.title: "Giant Baby",
	quest.0000000000103080.quest_desc: ["Blaze spawners are in the fortress towers. Bring a shield, a bow and something to stand behind. Rods are needed for the End and for brewing."],
	quest.0000000000103080.title: "Blazes",
	quest.0000000000103090.quest_desc: ["Wither skeletons drop a skull with roughly 2.5% chance. Looting III makes it much faster. You need three."],
	quest.0000000000103090.title: "Skulls",
	quest.00000000001030A0.quest_desc: ["Grows only on soul sand. Take a handful home: every potion starts with it."],
	quest.00000000001030A0.title: "Nether Wart",
	quest.00000000001030B0.quest_desc: ["Water bottle + nether wart + magma cream. Three minutes of swimming in lava. Brew a stack before the Wither fight."],
	quest.00000000001030B0.title: "Fire Resistance",
	quest.00000000001030C0.quest_desc: ["Orange glowing blocks in crimson forests, blue in warped ones. They light a base better than torches."],
	quest.00000000001030C0.title: "Shroomlights",
	quest.00000000001030D0.quest_desc: ["Skeletons here are fast and there are hundreds of them. Soul sand slows you down, soul soil does not — build paths from it."],
	quest.00000000001030D0.title: "Valley of Souls",
	quest.00000000001030E0.quest_desc: ["Nether gold ore gives nuggets even with a stone pickaxe. Nine nuggets make an ingot, and ingots make piglins friendly."],
	quest.00000000001030E0.title: "Nether Gold",
	quest.00000000001030F0.quest_desc: ["Throw a gold ingot at a piglin and wait. They pay with pearls, quartz, leather, and sometimes with the smithing template.", "Wear gold armor so they do not attack."],
	quest.00000000001030F0.title: "Barter",
	quest.0000000000103100.quest_desc: ["Black stone castles full of piglin brutes. They do not forgive gold theft. Loot the chests: the netherite upgrade template is here."],
	quest.0000000000103100.title: "Bastion Remnant",
	quest.0000000000103110.quest_desc: ["Hoglins attack on sight unless you stand in a warped forest. They drop leather and porkchops."],
	quest.0000000000103110.title: "Hoglin Hunt",
	quest.0000000000103120.quest_desc: ["Saddle a strider and steer with a warped fungus on a stick. Lava is their water."],
	quest.0000000000103120.title: "Ride the Strider",
	quest.0000000000103130.quest_desc: ["Hit one zombified piglin and every piglin within 32 blocks comes for you. Choose the moment carefully."],
	quest.0000000000103130.title: "Angry Crowd",
	quest.0000000000103140.quest_desc: ["Y=15, long tunnels every two blocks. Beds explode here and clear a large area — cheap mining, expensive sleep."],
	quest.0000000000103140.title: "Ancient Debris",
	quest.0000000000103150.quest_desc: ["Smelt debris in a furnace: four scrap and four gold make one netherite ingot."],
	quest.0000000000103150.title: "Netherite Scrap",
	quest.0000000000103160.quest_desc: ["The template is consumed on every upgrade, but it can be duplicated with diamonds and netherrack."],
	quest.0000000000103160.title: "Smithing Template",
	quest.0000000000103170.quest_desc: ["They do not burn in lava and mine faster than diamond."],
	quest.0000000000103170.title: "Netherite Tools",
	quest.0000000000103180.quest_desc: ["Four ingots per piece. Knockback resistance is the reason people grind for it."],
	quest.0000000000103180.title: "Netherite Armor",
	quest.0000000000103190.quest_desc: ["Found in bastions and ruined portals. Needed for the respawn anchor."],
	quest.0000000000103190.title: "Crying Obsidian",
	quest.00000000001031A0.quest_desc: ["Six crying obsidian and three glowstone. Charge with glowstone and use it — your spawn moves to the Nether."],
	quest.00000000001031A0.title: "Respawn Anchor",
	quest.00000000001031B0.quest_desc: ["A compass bound to a lodestone always points at it, in any dimension. Mark your portal."],
	quest.00000000001031B0.title: "Lodestone",
	quest.00000000001031C0.quest_desc: ["Four soul sand in a T, three skulls on top. Summon it in a long tunnel dug in the bedrock roof — the Wither cannot break through and you can shoot it from the side.", "Bring a bow with Power, golden apples and milk."],
	quest.00000000001031C0.title: "The Wither",
	quest.00000000001031D0.quest_desc: ["Three obsidian, five glass, one nether star. A pyramid of iron blocks underneath decides the radius and the effects."],
	quest.00000000001031D0.title: "Beacon",
	quest.00000000001031E0.quest_desc: ["A four-level pyramid: 164 blocks of iron, gold, diamond, emerald or netherite. All six effects at once."],
	quest.00000000001031E0.title: "Full Beacon",
	quest.00000000001031F0.quest_desc: ["Hold every status effect at the same time, including the bad ones. Beacon, potions, a witch and a pufferfish will help."],
	quest.00000000001031F0.title: "Whole Spectrum",
	quest.0000000000103200.quest_desc: ["A custom item of this pack: three netherite scrap around a token, three gold ingots underneath. The recipe is in JEI."],
	quest.0000000000103200.title: "Premium Token",
	quest.0000000000103210.quest_desc: ["Blaze powder plus an ender pearl. Take twelve: some of them break, and some will have to be thrown into the portal frame."],
	quest.0000000000103210.title: "Eyes of Ender",
	quest.0000000000103220.quest_desc: ["Throw an eye and follow it. When it starts going down, dig. The portal room is under the library."],
	quest.0000000000103220.title: "Stronghold",
	quest.0000000000103230.quest_desc: ["Food, blocks to bridge with, fireworks for the elytra later, and a bed you are NOT going to sleep in.", "Tick the box when the inventory is ready."],
	quest.0000000000103230.title: "Before the Fall",
	quest.0000000000104010.quest_desc: ["Jump into the starry portal. You appear on an obsidian platform; if it is broken, bring blocks.", "The dragon heals from the crystals on the pillars. Break them first."],
	quest.0000000000104010.title: "The End",
	quest.0000000000104020.quest_desc: ["Some crystals sit behind iron bars: dig up, or shoot through the gap. An exploded crystal hurts badly — keep distance."],
	quest.0000000000104020.title: "Obsidian Pillars",
	quest.0000000000104030.quest_desc: ["Shoot it in the wings when it circles, hit it with a sword when it sits on the fountain. Beds and anchors explode here too — some people kill it that way."],
	quest.0000000000104030.title: "The Ender Dragon",
	quest.0000000000104040.quest_desc: ["It teleports when hit. Put a piston next to it and power the piston, or place a torch two blocks below and break the block above."],
	quest.0000000000104040.title: "Dragon Egg",
	quest.0000000000104050.quest_desc: ["Use a glass bottle on the purple cloud the dragon leaves on the fountain, or on its fireball."],
	quest.0000000000104050.title: "Dragon Breath",
	quest.0000000000104060.quest_desc: ["Four end crystals on the exit portal bring the dragon back. It drops experience again and opens another gateway."],
	quest.0000000000104060.title: "Dragon Again",
	quest.0000000000104070.quest_desc: ["A small bedrock portal appears after the kill. Throw an ender pearl into it, or drink to fit through."],
	quest.0000000000104070.title: "The Gateway",
	quest.0000000000104080.quest_desc: ["Thousands of islands with chorus trees, end cities and ships. Bring blocks to bridge the gaps."],
	quest.0000000000104080.title: "Outer Islands",
	quest.0000000000104090.quest_desc: ["The fruit teleports you at random, the popped one is used for end rods and purpur. Bake it in a furnace."],
	quest.0000000000104090.title: "Chorus",
	quest.00000000001040A0.quest_desc: ["Here they are everywhere. A pumpkin on the head prevents eye contact; a two-block roof lets you fight safely."],
	quest.00000000001040A0.title: "Endermen of the End",
	quest.00000000001040B0.quest_desc: ["Get hit by a shulker bullet and float up 50 blocks without falling."],
	quest.00000000001040B0.title: "Levitation",
	quest.00000000001040C0.quest_desc: ["A copper spyglass and an amethyst shard. Look at the dragon through it during the fight."],
	quest.00000000001040C0.title: "Look Up",
	quest.00000000001040D0.quest_desc: ["Tall purple towers on the outer islands. The ship next to some of them carries exactly one thing you came for."],
	quest.00000000001040D0.title: "End City",
	quest.00000000001040E0.quest_desc: ["Their bullets levitate you. A shield blocks the bullet, and two shells make a shulker box."],
	quest.00000000001040E0.title: "Shulkers",
	quest.00000000001040F0.quest_desc: ["On the bow of the end ship, in an item frame. One pair per ship — and ships are far apart."],
	quest.00000000001040F0.title: "Wings",
	quest.0000000000104100.quest_desc: ["Jump, open the wings with the jump button, and boost with rockets made of paper and gunpowder."],
	quest.0000000000104100.title: "Flight",
	quest.0000000000104110.quest_desc: ["Two shells around a chest. It keeps its contents when broken — the best inventory in the game."],
	quest.0000000000104110.title: "Portable Chest",
	quest.0000000000104120.quest_desc: ["Purpur blocks and end rods are the building material of the cities. The dragon head sits on the bow of the ship, next to the elytra."],
	quest.0000000000104120.title: "Purple Stone",
	quest.0000000000104130.quest_desc: ["Everything that cannot be bought: the egg, the wings, the box and the star."],
	quest.0000000000104130.title: "Trophies",
	quest.0000000000104140.quest_desc: ["A custom item of this pack: two diamond blocks, two emerald blocks, two premium tokens and a nether star.", "Recipe is in JEI. Premium tokens are made in the Crimson Furnace chapter."],
	quest.0000000000104140.title: "Medal of the Master",
	quest.0000000000104150.quest_desc: ["Five hours of play and five hundred kills. The statistics are counted for the whole world, not for this chapter."],
	quest.0000000000104150.title: "Veteran",
	quest.0000000000104160.quest_desc: ["Three worlds, one book, every chapter closed. There is nothing left to tick — so tick this.", "Thanks for playing this pack."],
	quest.0000000000104160.title: "End of the Story",
	quest.0000000000105010.quest_desc: ["Eternal Starlight opens the Starlight dimension: night, auroras and 24 biomes.", "The portal is not built from blocks - the orb of prophecy opens it in your hands."],
	quest.0000000000105010.title: "A Sky of a Million Stars",
	quest.0000000000105020.quest_desc: ["Common, cold, desert, forest and jungle portal ruins: chests with dusted shards.", "Someone opened the gates before you - and did not come back."],
	quest.0000000000105020.title: "The Five Portal Ruins",
	quest.0000000000105030.quest_desc: ["Six forest biomes: from sparse taiga to dense canopies and torreya thickets.", "The compass spins: navigate by the glow of crystals."],
	quest.0000000000105030.title: "Starlight Forests",
	quest.0000000000105040.quest_desc: ["Starlit seas, kelp forests, warm and grim shores: the water glows at night.", "A boat is not a luxury but the only way across."],
	quest.0000000000105040.title: "Seas and Shores",
	quest.0000000000105050.quest_desc: ["Solaris isles, mycelium isles, umbral plains and shimmering scrublands.", "Each isle hides its own flora - and its own danger."],
	quest.0000000000105050.title: "Isles and Plains",
	quest.0000000000105060.quest_desc: ["Permafrost peaks, crystallized desert and the Abyss: the darkest biome.", "In the Abyss lives the reason this chapter is worth finishing."],
	quest.0000000000105060.title: "Ice, Desert and the Abyss",
	quest.0000000000105070.quest_desc: ["The forge births starlight golems; in the garden nothing blooms twice.", "In the forge look for energy blocks: deactivate them and the golem becomes vulnerable."],
	quest.0000000000105070.title: "The Golem Forge and the Cursed Garden",
	quest.0000000000105080.quest_desc: ["A den in the dark: the stranghoul hunts here at night.", "A bowl of spicy stew hires it for a day. Seriously."],
	quest.0000000000105080.title: "The Stranghoul Den",
	quest.0000000000105090.quest_desc: ["Ratlin, gleech and shadow snail: the humble fauna of the dimension.", "A thrown gleech egg heals by bloodletting - hit a mob, not yourself."],
	quest.0000000000105090.title: "Small Fry of the Star Night",
	quest.00000000001050A0.quest_desc: ["The aurora deer drops antlers only when it rams hard blocks - make it angry.", "The crystallized moth is tamed with meat and strikes with a sound wave."],
	quest.00000000001050A0.title: "The Gentle and the Winged",
	quest.00000000001050B0.quest_desc: ["Luminofish glows, rookfish is armour-plated: both bite at night.", "The rookfish air sac is the core of breathing boots."],
	quest.00000000001050B0.title: "Angler of the Star Seas",
	quest.00000000001050C0.quest_desc: ["Do not kill the starfire bird for starfire: put seeds in its nest instead.", "The ent is an old tree that walks. It does not like axes."],
	quest.00000000001050C0.title: "The Bird and the Ent",
	quest.00000000001050D0.quest_desc: ["Dusk spiders, star skeletons and the thirst walker: the night has teeth.", "The walker's tooth of hunger is a building material - and a weapon."],
	quest.00000000001050D0.title: "Night Hunters",
	quest.00000000001050E0.quest_desc: ["Creteors fall with meteor showers; the yeti wears the permafrost; the seeker watches.", "Its tentacle becomes a spike - and a key to abyssal loot."],
	quest.00000000001050E0.title: "Elements and Predators",
	quest.00000000001050F0.quest_desc: ["The permafrost spits from afar and hides under ashen snow.", "The stranghoul hunts other mobs: witness a hunt - and hire the hunter."],
	quest.00000000001050F0.title: "Permafrost and Stranghoul",
	quest.0000000000105100.quest_desc: ["The tangled, its husk and skull: the tenacious vine does not let go even of the dead.", "The skull explodes - chain two kills for the mod achievement."],
	quest.0000000000105100.title: "A Tangled Death",
	quest.0000000000105110.quest_desc: ["First boss: the Gatekeeper tests the worthy with fireballs and fury.", "Pass his challenge - and take what he guards."],
	quest.0000000000105110.title: "The Gatekeeper",
	quest.0000000000105120.quest_desc: ["The second boss waits in the Abyss. Ignite it - only fire makes it vulnerable.", "Breath and thorns fly in arcs: keep distance, do not stand in the pools."],
	quest.0000000000105120.title: "The Lunar Monstrosity",
	quest.0000000000105130.quest_desc: ["The grimstone golem is summoned with a carved lunar cactus on bricks.", "The starlight golem is invulnerable while its energy block hums: deactivate or freeze it."],
	quest.0000000000105130.title: "Golems of Stone and Light",
	quest.0000000000105140.quest_desc: ["The astral golem falls from the sky with the meteor shower.", "The aethersent one is summoned with a carved cactus on an aethersent block."],
	quest.0000000000105140.title: "Golems of Sky and Aether",
	quest.0000000000105150.quest_desc: ["Glacite, thioquartz, dusted shard, malarite, starlit diamond and starfire.", "Starfire is not mined: help the starfire birds nest - and they will share."],
	quest.0000000000105150.title: "Six Tears of the Starlight",
	quest.0000000000105160.quest_desc: ["Saltpetre, shivering gel, soul dew, crinoa, cactus gel and velvet moss.", "Each is a reagent: bombs, stews and amulets all start here."],
	quest.0000000000105160.title: "The Soft Materials",
	quest.0000000000105170.quest_desc: ["Glacite, deepsilver, unrealium, aethersent and golem steel: the metal ladder.", "The alloy furnace smelts what a normal one cannot."],
	quest.0000000000105170.title: "Five Ingots",
	quest.0000000000105180.quest_desc: ["Throw starfire into sand - flowglaze. Hew torreya logs - amaramber.", "The crystalborn catalyst runs on crystals and redstone: a desertification machine."],
	quest.0000000000105180.title: "Liquid Glow and Resin",
	quest.0000000000105190.quest_desc: ["Voidstone and nightfall mud hold the veins: silk touch keeps the block, fortune the count.", "This is the ore map of the dimension: the arsenal follows it."],
	quest.0000000000105190.title: "Veins of the Deep Rocks",
	quest.00000000001051A0.quest_desc: ["Thermal springstone lies under giant plants: only fire burns them away.", "Blades of this tier share one temper - and one upgrade path."],
	quest.00000000001051A0.title: "Weapons: the thermal springstone set",
	quest.00000000001051B0.quest_desc: ["Thermal springstone lies under giant plants: only fire burns them away.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.00000000001051B0.title: "Tools: the thermal springstone set",
	quest.00000000001051C0.quest_desc: ["Thermal springstone lies under giant plants: only fire burns them away.", "Four pieces, one glow: wear the whole set."],
	quest.00000000001051C0.title: "Armour: the thermal springstone set",
	quest.00000000001051D0.quest_desc: ["Glacite is forged from shards of the permafrost peaks.", "Blades of this tier share one temper - and one upgrade path."],
	quest.00000000001051D0.title: "Weapons: the glacite set",
	quest.00000000001051E0.quest_desc: ["Glacite is forged from shards of the permafrost peaks.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.00000000001051E0.title: "Tools: the glacite set",
	quest.00000000001051F0.quest_desc: ["Glacite is forged from shards of the permafrost peaks.", "Four pieces, one glow: wear the whole set."],
	quest.00000000001051F0.title: "Armour: the glacite set",
	quest.0000000000105200.quest_desc: ["Malarite is dug from night swamp mud; its spear outreaches a sword.", "Blades of this tier share one temper - and one upgrade path."],
	quest.0000000000105200.title: "Weapons: the malarite set",
	quest.0000000000105210.quest_desc: ["Malarite is dug from night swamp mud; its spear outreaches a sword.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.0000000000105210.title: "Tools: the malarite set",
	quest.0000000000105220.quest_desc: ["Deepsilver does not tarnish in the dusk: look in packed mud.", "Blades of this tier share one temper - and one upgrade path."],
	quest.0000000000105220.title: "Weapons: the deepsilver set",
	quest.0000000000105230.quest_desc: ["Deepsilver does not tarnish in the dusk: look in packed mud.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.0000000000105230.title: "Tools: the deepsilver set",
	quest.0000000000105240.quest_desc: ["Deepsilver does not tarnish in the dusk: look in packed mud.", "Four pieces, one glow: wear the whole set."],
	quest.0000000000105240.title: "Armour: the deepsilver set",
	quest.0000000000105250.quest_desc: ["Starlit diamond is harder than diamond and glows faintly in the dark.", "Blades of this tier share one temper - and one upgrade path."],
	quest.0000000000105250.title: "Weapons: the starlit diamond set",
	quest.0000000000105260.quest_desc: ["Starlit diamond is harder than diamond and glows faintly in the dark.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.0000000000105260.title: "Tools: the starlit diamond set",
	quest.0000000000105270.quest_desc: ["Starlit diamond is harder than diamond and glows faintly in the dark.", "Four pieces, one glow: wear the whole set."],
	quest.0000000000105270.title: "Armour: the starlit diamond set",
	quest.0000000000105280.quest_desc: ["Unrealium is lighter than shadow: a full set is the mod achievement.", "Blades of this tier share one temper - and one upgrade path."],
	quest.0000000000105280.title: "Weapons: the unrealium set",
	quest.0000000000105290.quest_desc: ["Unrealium is lighter than shadow: a full set is the mod achievement.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.0000000000105290.title: "Tools: the unrealium set",
	quest.00000000001052A0.quest_desc: ["Unrealium is lighter than shadow: a full set is the mod achievement.", "Four pieces, one glow: wear the whole set."],
	quest.00000000001052A0.title: "Armour: the unrealium set",
	quest.00000000001052B0.quest_desc: ["Starfire gear burns with a cold flame the birds gave you.", "Blades of this tier share one temper - and one upgrade path."],
	quest.00000000001052B0.title: "Weapons: the starfire set",
	quest.00000000001052C0.quest_desc: ["Starfire gear burns with a cold flame the birds gave you.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.00000000001052C0.title: "Tools: the starfire set",
	quest.00000000001052D0.quest_desc: ["Flowglaze flows where you strike: the sand remembers the starfire.", "Blades of this tier share one temper - and one upgrade path."],
	quest.00000000001052D0.title: "Weapons: the flowglaze set",
	quest.00000000001052E0.quest_desc: ["Flowglaze flows where you strike: the sand remembers the starfire.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.00000000001052E0.title: "Tools: the flowglaze set",
	quest.00000000001052F0.quest_desc: ["Amaramber is the resin of torreya: warm, amber, stubborn.", "Blades of this tier share one temper - and one upgrade path."],
	quest.00000000001052F0.title: "Weapons: the amaramber set",
	quest.0000000000105300.quest_desc: ["Amaramber is the resin of torreya: warm, amber, stubborn.", "Scythes mow grass in bundles; sickles cut ears; the brush is for archaeology."],
	quest.0000000000105300.title: "Tools: the amaramber set",
	quest.0000000000105310.quest_desc: ["Amaramber is the resin of torreya: warm, amber, stubborn.", "Four pieces, one glow: wear the whole set."],
	quest.0000000000105310.title: "Armour: the amaramber set",
	quest.0000000000105320.quest_desc: ["The starfire template upgrades thermal gear; flowglaze upgrades glacite gear.", "The smithing table is the stair between tiers."],
	quest.0000000000105320.title: "Templates of Ascent",
	quest.0000000000105330.quest_desc: ["Feed it with strikes: the hungry dagger hits harder when fed.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105330.title: "Dagger of Hunger",
	quest.0000000000105340.quest_desc: ["Join blade and hilt: shattered does not mean dead.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105340.title: "Shattered Sword",
	quest.0000000000105350.quest_desc: ["It glisters where it strikes: first of the glistering family.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105350.title: "Glistering Sword",
	quest.0000000000105360.quest_desc: ["The two-handed glistering: wide swing, wide shine.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105360.title: "Glistering Greatsword",
	quest.0000000000105370.quest_desc: ["Its arrows shine like tracers.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105370.title: "Glistering Bow",
	quest.0000000000105380.quest_desc: ["The morning star: heavy, honest, toothy.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105380.title: "Glistering Morning Star",
	quest.0000000000105390.quest_desc: ["The energy sword: a blade of pure spark.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105390.title: "Energy Sword",
	quest.00000000001053A0.quest_desc: ["It returns. Always. Keep your hand open.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053A0.title: "Energy Boomerang",
	quest.00000000001053B0.quest_desc: ["Golem steel greatsword: slow as a golem, and as inevitable.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053B0.title: "Golem Steel Greatsword",
	quest.00000000001053C0.quest_desc: ["The mechanical crossbow: reloads itself, forgives a shaking hand.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053C0.title: "Mechanical Crossbow",
	quest.00000000001053D0.quest_desc: ["Crystal greatsword: a heavy shard of a constellation.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053D0.title: "Crystal Greatsword",
	quest.00000000001053E0.quest_desc: ["Crystal crossbow: hits with ice and light.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053E0.title: "Crystal Crossbow",
	quest.00000000001053F0.quest_desc: ["The wilted crossbow: garden poison in every bolt.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001053F0.title: "Wilted Crossbow",
	quest.0000000000105400.quest_desc: ["Moonring bow: the arrow arc mirrors the moon.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105400.title: "Moonring Bow",
	quest.0000000000105410.quest_desc: ["The greater moonring: a lunar crescent in steel.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105410.title: "Moonring Greatsword",
	quest.0000000000105420.quest_desc: ["Crescent spear: reaches where a sword cannot.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105420.title: "Crescent Spear",
	quest.0000000000105430.quest_desc: ["Gravity pickaxe: ore pulls itself into your inventory.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105430.title: "Gravity Pickaxe",
	quest.0000000000105440.quest_desc: ["Bow of blood: drinks the enemy's life and shares with you.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105440.title: "Bow of Blood",
	quest.0000000000105450.quest_desc: ["Coldsnap: a whip of eternal ice, frost instead of a wound.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105450.title: "Coldsnap",
	quest.0000000000105460.quest_desc: ["Candlash: sweet to look at, bitter to hit.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105460.title: "Candlash",
	quest.0000000000105470.quest_desc: ["The underminer: digs the enemy from inside their armour.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105470.title: "Underminer",
	quest.0000000000105480.quest_desc: ["The flesh grinder: not for the faint of stomach.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105480.title: "Flesh Grinder",
	quest.0000000000105490.quest_desc: ["Bonemore: a shield in one hand, an argument in the other.", "One of the twenty-six unique blades of the Starlight."],
	quest.0000000000105490.title: "Bonemore",
	quest.00000000001054A0.quest_desc: ["The living arm: a weapon that holds you, not the other way.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001054A0.title: "Living Arm",
	quest.00000000001054B0.quest_desc: ["Pungency fruit spear: numbness instead of a wound.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001054B0.title: "Pungency Fruit Spear",
	quest.00000000001054C0.quest_desc: ["Pungency fruit axe: a salad weapon.", "One of the twenty-six unique blades of the Starlight."],
	quest.00000000001054C0.title: "Pungency Fruit Axe",
	quest.00000000001054D0.quest_desc: ["Glacite arrow: slows the target with frost.", "Fletch a bundle: the quiver quest is next."],
	quest.00000000001054D0.title: "Glacite Arrow",
	quest.00000000001054E0.quest_desc: ["Malarite arrow: heavy and straightforward.", "Fletch a bundle: the quiver quest is next."],
	quest.00000000001054E0.title: "Malarite Arrow",
	quest.00000000001054F0.quest_desc: ["Amaramber arrow: resin clings to the wound.", "Fletch a bundle: the quiver quest is next."],
	quest.00000000001054F0.title: "Amaramber Arrow",
	quest.0000000000105500.quest_desc: ["Thioquartz arrow: sparks with sulphur.", "Fletch a bundle: the quiver quest is next."],
	quest.0000000000105500.title: "Thioquartz Arrow",
	quest.0000000000105510.quest_desc: ["Air sac arrow: light flight, light damage.", "Fletch a bundle: the quiver quest is next."],
	quest.0000000000105510.title: "Air Sac Arrow",
	quest.0000000000105520.quest_desc: ["Voracious arrow: finishes what the bolt did not.", "Fletch a bundle: the quiver quest is next."],
	quest.0000000000105520.title: "Voracious Arrow",
	quest.0000000000105530.quest_desc: ["Aethersent arrow: glows in flight - a lantern of the night.", "Fletch a bundle: the quiver quest is next."],
	quest.0000000000105530.title: "Aethersent Arrow",
	quest.0000000000105540.quest_desc: ["All seven arrow kinds, four of each, in one quiver.", "The galactic quiver keeps them sorted even in the dark."],
	quest.0000000000105540.title: "The Galactic Quiver",
	quest.0000000000105550.quest_desc: ["Hood, cape, bottoms and boots of aethersent: the sky-weave set.", "It fell from the sky with the meteors - weave it back."],
	quest.0000000000105550.title: "The Aethersent Raiment",
	quest.0000000000105560.quest_desc: ["The alchemist set breathes where nothing breathes; air sac boots soften falls.", "The Abyss becomes a little kinder with them."],
	quest.0000000000105560.title: "Mask, Robe, Boots",
	quest.0000000000105570.quest_desc: ["Keeper, forge, blooming and twining: four patterns for the smithing table.", "Trim is the armour's final flourish."],
	quest.0000000000105570.title: "Four Trim Patterns",
	quest.0000000000105580.quest_desc: ["Starlight cooking: everything edible and everything from here.", "Spicy fruit gives numbness - it absorbs damage for you."],
	quest.0000000000105580.title: "Berries and Fruits",
	quest.0000000000105590.quest_desc: ["Starlight cooking: everything edible and everything from here.", "Spicy fruit gives numbness - it absorbs damage for you."],
	quest.0000000000105590.title: "Grains and Porridges",
	quest.00000000001055A0.quest_desc: ["Starlight cooking: everything edible and everything from here.", "Spicy fruit gives numbness - it absorbs damage for you."],
	quest.00000000001055A0.title: "Meat and Fish",
	quest.00000000001055B0.quest_desc: ["Starlight cooking: everything edible and everything from here.", "Spicy fruit gives numbness - it absorbs damage for you."],
	quest.00000000001055B0.title: "Hot and Hearty",
	quest.00000000001055C0.quest_desc: ["Pocket miracles of the Starlight: each has a use, none is ballast.", "The aetherstrike rocket calls a meteor shower - make a wish."],
	quest.00000000001055C0.title: "Amulets",
	quest.00000000001055D0.quest_desc: ["Pocket miracles of the Starlight: each has a use, none is ballast.", "The aetherstrike rocket calls a meteor shower - make a wish."],
	quest.00000000001055D0.title: "Warrior Pendants",
