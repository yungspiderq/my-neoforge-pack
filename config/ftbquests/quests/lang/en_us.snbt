{
	chapter.000000000000C001.chapter_subtitle: ["One world, one life, one book. Everything you need is under your feet.", "Sections are read left to right, top to bottom; the arrows show what unlocks what."],
	chapter.000000000000C001.title: "Dawnlands",
	chapter.000000000000C002.chapter_subtitle: ["No water, no sleep, no sky. Everything here burns or wants to burn you.", "Get in through the portal from the Dawnlands, get out through the stronghold."],
	chapter.000000000000C002.title: "The Crimson Furnace",
	chapter.000000000000C003.chapter_subtitle: ["Nothing grows here and nothing forgives a mistake. Only islands, dragons and loot.", "The last chapter: the dragon, the wings and the medal of the pack."],
	chapter.000000000000C003.title: "Edge of the Void",
	chapter.000000000000C004.chapter_subtitle: ["The mod Galosphere: three cave biomes, two structures, palladium, sterling armor, moles with pouches and a berserker under the salt.", "The entrance is below the Deep Dark in the Dawnlands — through the pink portal. Everything the mod has is covered here."],
	chapter.000000000000C004.title: "Galosphere",
	chapter.000000000000C005.chapter_subtitle: ["The Eternal Starlight mod: the Starlight dimension, 24 biomes, 8 structures, two bosses, nine gear tiers and over a thousand blocks and items.", "The portal is opened by the orb of prophecy. Everything the mod has is covered here: not a single item is lost."],
	chapter.000000000000C005.title: "The Eternal Starlight",
	image.0000000000401002.title: "Awakening",
	image.0000000000401004.title: "Under the Ground",
	image.0000000000401006.title: "Wild Lands",
	image.0000000000401008.title: "Farm and Food",
	image.000000000040100A.title: "Steel and Fang",
	image.000000000040100C.title: "Enchanting",
	image.000000000040100E.title: "Contraptions",
	image.0000000000401010.title: "The Gate",
	image.0000000000401016.title: "To the Nether",
	image.0000000000401017.title: "To the Galosphere",
	image.0000000000401018.title: "XP is consumed!",
	image.0000000000401019.title: "Sneak. Do not run.",
	image.0000000000402002.title: "Arrival",
	image.0000000000402004.title: "The Fortress",
	image.0000000000402006.title: "Gold and Swine",
	image.0000000000402008.title: "Black Gold",
	image.000000000040200A.title: "Lords of Hell",
	image.000000000040200C.title: "Way Back Up",
	image.0000000000402012.title: "Boss. Prepare first.",
	image.0000000000402013.title: "Y = 15, dig sideways",
	image.0000000000402014.title: "To the End",
	image.0000000000403002.title: "The Fall",
	image.0000000000403004.title: "Outer Islands",
	image.0000000000403006.title: "City of the End",
	image.0000000000403008.title: "Pack Master",
	image.000000000040300E.title: "Piston, not a pickaxe",
	image.000000000040300F.title: "Throw a pearl in",
	image.0000000000403010.title: "Thank you for playing",
	image.0000000000404002.title: "Pink Salt",
	image.0000000000404004.title: "Lichen Gardens",
	image.0000000000404006.title: "Crystal Canyons",
	image.0000000000404008.title: "Palladium & Sterling",
	image.000000000040400A.title: "Moles and Pouches",
	image.000000000040400C.title: "Ruins & Archaeology",
	image.000000000040400E.title: "Workshop of Depths",
	image.0000000000404010.title: "Shrine & Berserker",
	image.0000000000404018.title: "To the Dawnlands",
	image.0000000000404019.title: "Mod: Galosphere 1.5.5",
	image.000000000040401A.title: "Gifts are random!",
	image.000000000040401B.title: "Ring the bell at the altar",
	image.0000000000405002.title: "The Road to the Starlight",
	image.0000000000405004.title: "The Bestiary",
	image.0000000000405006.title: "Ores and Materials",
	image.0000000000405008.title: "The Arsenal",
	image.000000000040500A.title: "Table and Pocket",
	image.000000000040500C.title: "Building",
	image.000000000040500E.title: "The Star Encyclopaedia",
	quest.0000000000101010.quest_desc: ["Hold the left mouse button on a tree trunk. Sixteen logs is enough to start; the rest you will get from saplings.", "Everything in this book starts here."],
	quest.0000000000101010.title: "First Wood",
	quest.0000000000101020.quest_desc: ["Planks in the inventory crafting grid, then four planks into a table. From now on 3x3 recipes are available."],
	quest.0000000000101020.title: "Workbench",
	quest.0000000000101030.quest_desc: ["A wooden pickaxe digs stone, a wooden axe chops twice as fast. They break quickly — that is normal."],
	quest.0000000000101030.title: "Wooden Set",
	quest.0000000000101040.title: "Stone Age",
	quest.0000000000101050.quest_desc: ["Coal from a vein or from a charcoal kiln: put logs on top, fuel underneath. Interact with the furnace at least once."],
	quest.0000000000101050.title: "Furnace",
	quest.0000000000101060.quest_desc: ["A door stops zombies, a chest stores the loot, a ladder gets you out of the hole. The house can be a hole in a hill."],
	quest.0000000000101060.title: "Four Walls",
	quest.0000000000101070.quest_desc: ["Three wool and three planks. Sleeping skips the night and moves the spawn point — you will not walk back across the map after dying."],
	quest.0000000000101070.title: "Good Night",
	quest.0000000000101080.quest_desc: ["Mobs spawn where the light level is zero. Torches are the cheapest way to keep your house and your mine empty."],
	quest.0000000000101080.title: "Light in the Dark",
	quest.0000000000101090.quest_desc: ["Raw iron is smelted in a furnace. Eight ingots is a full set of tools and a bucket."],
	quest.0000000000101090.title: "Iron Age",
	quest.00000000001010A0.quest_desc: ["Sword, pickaxe, axe, shovel and a shield. The shield blocks arrows and creeper explosions — hold it in the off-hand and crouch."],
	quest.00000000001010A0.title: "Full Kit",
	quest.00000000001010B0.title: "Armor",
	quest.00000000001010C0.quest_desc: ["Water turns lava into obsidian, lava melts sand into glass. A bucket is the most useful tool after the pickaxe."],
	quest.00000000001010C0.title: "Bucket",
	quest.00000000001010D0.quest_desc: ["Below Y=0 stone turns into deepslate. Dig a staircase, not a shaft: you cannot jump out of a 1x1 hole."],
	quest.00000000001010D0.title: "Down We Go",
	quest.00000000001010E0.title: "Black Gold",
	quest.00000000001010F0.quest_desc: ["Copper is needed for a lightning rod, a spyglass and the copper bulb. It oxidises, but that is only cosmetic."],
	quest.00000000001010F0.title: "Copper",
	quest.0000000000101100.title: "Red Dust",
	quest.0000000000101110.quest_desc: ["Save it: enchanting consumes lapis by the handful."],
	quest.0000000000101110.title: "Lapis Lazuli",
	quest.0000000000101120.title: "Gold",
	quest.0000000000101130.quest_desc: ["Best height is Y=-59, and always dig sideways with a two-block ceiling. Five diamonds: a pickaxe plus two spares."],
	quest.0000000000101130.title: "Diamonds!",
	quest.0000000000101140.quest_desc: ["Get down to Y=-60. Bedrock is at -64, lava oceans are between. Take a water bucket."],
	quest.0000000000101140.title: "Bottom of the World",
	quest.0000000000101150.quest_desc: ["A dark sphere of smooth basalt hides amethyst. Listen: the blocks chime when you walk on them."],
	quest.0000000000101150.title: "Amethyst Geode",
	quest.0000000000101160.quest_desc: ["Emerald ore only generates under mountains. Villagers will pay for everything else anyway."],
	quest.0000000000101160.title: "Emeralds",
	quest.0000000000101170.quest_desc: ["Dripstone caves stab you from above, lush caves glow with berries. Both are worth a look."],
	quest.0000000000101170.title: "Crystal and Moss",
	quest.0000000000101180.quest_desc: ["Sculk hears you. Sneak, do not run, do not place blocks on the sensors. Wool muffles vibrations."],
	quest.0000000000101180.title: "Deep Dark",
	quest.0000000000101190.quest_desc: ["A huge dark structure under the deep dark. Chests hold the Swift Sneak book and the disc fragments. Do not break the portal frame."],
	quest.0000000000101190.title: "Ancient City",
	quest.00000000001011A0.quest_desc: ["Sneak within 8 blocks of a sculk sensor and stay alive. The Warden is not meant to be killed: it drops nothing."],
	quest.00000000001011A0.title: "Do Not Breathe",
	quest.00000000001011B0.quest_desc: ["A copper-and-tuff structure with vaults. A trial key opens a normal vault, an ominous key — the good ones."],
	quest.00000000001011B0.title: "Trial Chamber",
	quest.00000000001011C0.quest_desc: ["Pour water over a lava lake, then mine it with a diamond pickaxe. Fourteen blocks: ten for the portal, four for an enchanting table."],
	quest.00000000001011C0.title: "Obsidian",
	quest.00000000001011D0.quest_desc: ["The compass always points at the world spawn. Walk until the landscape stops repeating."],
	quest.00000000001011D0.title: "First Step Out",
	quest.00000000001011E0.quest_desc: ["Talk to a villager with the trade key (right-click). The librarian sells enchanted books for emeralds — find him first."],
	quest.00000000001011E0.title: "Village",
	quest.00000000001011F0.quest_desc: ["Five trades of any kind. Trading also refreshes the villager's stock."],
	quest.00000000001011F0.title: "Merchant",
	quest.0000000000101200.quest_desc: ["A dark oak tower with cages. Killing the captain gives Bad Omen — do not walk into a village with it."],
	quest.0000000000101200.title: "Pillager Outpost",
	quest.0000000000101210.quest_desc: ["Bring Bad Omen into a village and survive all waves. Vindicators and a ravager come at the end."],
	quest.0000000000101210.title: "Hero of the Village",
	quest.0000000000101220.quest_desc: ["Desert, taiga, jungle, swamp and savanna. Biomes count when you stand in them, the map is not enough."],
	quest.0000000000101220.title: "Five Lands",
	quest.0000000000101230.title: "To the Sea",
	quest.0000000000101240.quest_desc: ["Guardians do not let you mine. Drink a water-breathing potion or drain the monument; the elder guardian is inside."],
	quest.0000000000101240.title: "Ocean Monument",
	quest.0000000000101250.quest_desc: ["A map from a wreck leads to buried treasure: dig where the red cross is. The heart of the sea is inside."],
	quest.0000000000101250.title: "Shipwreck",
	quest.0000000000101260.quest_desc: ["Goats drop a horn when they ram a block. Snowy slopes and stony peaks are where to look."],
	quest.0000000000101260.title: "Peaks",
	quest.0000000000101270.quest_desc: ["Pink trees on top of mountains. Petals fall from the leaves."],
	quest.0000000000101270.title: "Cherry Grove",
	quest.0000000000101280.quest_desc: ["A cartographer villager sells the map. Inside: evokers, and every one of them drops a totem."],
	quest.0000000000101280.title: "Woodland Mansion",
	quest.0000000000101290.quest_desc: ["Bones for a wolf, fish for a cat, a saddle for a horse. A tamed animal follows you and can be healed with meat."],
	quest.0000000000101290.title: "Companions",
	quest.00000000001012A0.quest_desc: ["Break tall grass for seeds, hoe the dirt next to water and plant. Bone meal speeds everything up."],
	quest.00000000001012A0.title: "Seeds",
	quest.00000000001012B0.title: "Bread",
	quest.00000000001012C0.quest_desc: ["Carrots and potatoes come from village farms and zombies. Beetroot is fast but not very filling."],
	quest.00000000001012C0.title: "Kitchen Garden",
	quest.00000000001012D0.quest_desc: ["Feed two animals of the same kind their favourite food and they will produce a baby. Ten of any kind counts."],
	quest.00000000001012D0.title: "Breeding",
	quest.00000000001012E0.title: "Full Yard",
	quest.00000000001012F0.quest_desc: ["Shears do not hurt the sheep and regrow after feeding. Dye changes the colour of the wool."],
	quest.00000000001012F0.title: "Wool",
	quest.0000000000101300.quest_desc: ["Treasure comes from an open water surface at least 5x4x5. Enchant the rod with Luck of the Sea to get it faster."],
	quest.0000000000101300.title: "Fishing",
	quest.0000000000101310.quest_desc: ["Look at a bee nest for a few seconds — the task counts the glance. Shears give honeycomb, a bottle gives honey."],
	quest.0000000000101310.title: "Apiary",
	quest.0000000000101320.title: "Melon and Pumpkin",
	quest.0000000000101330.quest_desc: ["Eight nuggets around a carrot. The best saturation in the game — take a stack into the Nether."],
	quest.0000000000101330.title: "Golden Carrot",
	quest.0000000000101340.title: "Cake",
	quest.0000000000101350.quest_desc: ["Eat everything edible in the game, including pufferfish and spider eyes. Long, dull, and worth the achievement."],
	quest.0000000000101350.title: "Balanced Diet",
	quest.0000000000101360.quest_desc: ["Zombies burn in the sun and drop rotten flesh. Five of them is one night of standing your ground."],
	quest.0000000000101360.title: "First Blood",
	quest.0000000000101370.quest_desc: ["A skeleton shoots from 16 blocks. Use a shield and a corner, or dig down and hit from below."],
	quest.0000000000101370.title: "Bones",
	quest.0000000000101380.quest_desc: ["Cave spiders are smaller and poisonous, they live in abandoned mines wrapped in cobwebs."],
	quest.0000000000101380.title: "Eight Legs",
	quest.0000000000101390.quest_desc: ["Hit and step back, or lure a skeleton to kill it. Charged creepers spawn from lightning and drop heads."],
	quest.0000000000101390.title: "Do Not Hiss",
	quest.00000000001013A0.quest_desc: ["A fully drawn bow flies further. Hold the shield in the off-hand while shooting to survive the return fire."],
	quest.00000000001013A0.title: "Marksman",
	quest.00000000001013B0.quest_desc: ["Do not look at his face. Fight under a roof two blocks high — he cannot reach you there."],
	quest.00000000001013B0.title: "Tall Guest",
	quest.00000000001013C0.quest_desc: ["Slimes spawn in swamps at night and in slime chunks below Y=40. Big ones split into smaller ones."],
	quest.00000000001013C0.title: "Slime",
	quest.00000000001013D0.title: "Shield Wall",
	quest.00000000001013E0.quest_desc: ["250 kills of any mobs. Counted by the game statistic, not by this quest book."],
	quest.00000000001013E0.title: "Hunter",
	quest.00000000001013F0.quest_desc: ["Four iron blocks in a T and a carved pumpkin on top. He defends the village and you."],
	quest.00000000001013F0.title: "Iron Guardian",
	quest.0000000000101400.quest_desc: ["Kill one of every hostile mob in the game, including the Wither and the Ender Dragon. This is a season of play."],
	quest.0000000000101400.title: "Head Collection",
	quest.0000000000101410.quest_desc: ["Drowned carry tridents rarely; farms on the ocean work better. A trident with Loyalty returns to your hand."],
	quest.0000000000101410.title: "Trident",
	quest.0000000000101420.quest_desc: ["The task CONSUMES ten levels: experience is the currency of enchanting. Bottle it later, or grind mobs now."],
	quest.0000000000101420.title: "Experience",
	quest.0000000000101430.quest_desc: ["Four obsidian, two diamonds, one book. Look at the table for a couple of seconds to complete the observation task."],
	quest.0000000000101430.title: "Enchanting Table",
	quest.0000000000101440.quest_desc: ["Fifteen bookshelves one block away from the table unlock level 30 enchantments. Air must be between them."],
	quest.0000000000101440.title: "Library",
	quest.0000000000101450.quest_desc: ["Third slot, three levels of luck, and hope for Fortune or Silk Touch."],
	quest.0000000000101450.title: "First Enchantment",
	quest.0000000000101460.title: "Diamond Bar",
	quest.0000000000101470.quest_desc: ["Merges enchantments and repairs gear. Each use makes the next repair more expensive."],
	quest.0000000000101470.title: "Anvil",
	quest.0000000000101480.quest_desc: ["Three blaze rods and a nether wart make the base potion. Until then you can brew awkward potions from water bottles."],
	quest.0000000000101480.title: "Brewing Stand",
	quest.0000000000101490.quest_desc: ["A smithing table upgrades diamond gear to netherite, a grindstone strips enchantments and returns some experience."],
	quest.0000000000101490.title: "Smithing",
	quest.00000000001014A0.quest_desc: ["A custom item of this pack: a diamond, a gold ingot and an emerald in any arrangement. The recipe is in JEI.", "Tokens are collected, not used. The premium token needs netherite."],
	quest.00000000001014A0.title: "Quest Token",
	quest.00000000001014B0.quest_desc: ["A signal travels 15 blocks; a repeater refreshes it. A comparator reads the fullness of a chest."],
	quest.00000000001014B0.title: "Wiring",
	quest.00000000001014C0.title: "Pistons",
	quest.00000000001014D0.quest_desc: ["An observer sees a block change, a hopper moves items. Together they build every automatic farm."],
	quest.00000000001014D0.title: "Observers and Hoppers",
	quest.00000000001014E0.quest_desc: ["A powered rail needs gold and a redstone torch. Ride two kilometres to complete the statistic."],
	quest.00000000001014E0.title: "Railway",
	quest.00000000001014F0.quest_desc: ["Right-click tunes a note block, a record in a jukebox plays until it ends. Records drop from creepers killed by skeletons."],
	quest.00000000001014F0.title: "Music",
	quest.0000000000101500.quest_desc: ["Gunpowder and sand. Useful for digging down fast and for waking the whole neighbourhood."],
	quest.0000000000101500.title: "Boom",
	quest.0000000000101510.quest_desc: ["Build any automatic farm: iron, gold, crops or mob grinder. There is no item to hand in — tick the box yourself when it works."],
	quest.0000000000101510.title: "Own Contraption",
	quest.0000000000101520.quest_desc: ["Flint from gravel, iron ingot. It lights the portal and the TNT."],
	quest.0000000000101520.title: "Flint and Steel",
	quest.0000000000101530.quest_desc: ["One of three is enough: full iron armor, enchanted diamond gear or a brewing stand. The Nether does not care which one you chose."],
	quest.0000000000101530.title: "Pick Your Path",
	quest.0000000000101540.quest_desc: ["Ten obsidian minimum: a 4x5 frame without corners works. Light it with flint and steel and step in.", "One block in the Nether is eight blocks in the Overworld. That is how you travel fast."],
	quest.0000000000101540.title: "The Nether Gate",
	quest.0000000000102010.quest_desc: ["There is no night here, no rain and no safe place. Build a shelter around the portal before you walk away: ghasts break it easily.", "Coordinates here are one eighth of the Overworld ones."],
	quest.0000000000102010.title: "Step Into the Fire",
	quest.0000000000102020.quest_desc: ["Netherrack melts instantly and is the cheapest building material here. Do not build a house of it."],
	quest.0000000000102020.title: "Blood Stone",
	quest.0000000000102030.quest_desc: ["Nether quartz ore gives experience and clean white blocks. It is everywhere, just look down."],
	quest.0000000000102030.title: "Quartz",
	quest.0000000000102040.quest_desc: ["Hanging clusters under the ceiling. Break with Silk Touch to get whole blocks, otherwise dust."],
	quest.0000000000102040.title: "Glowstone",
	quest.0000000000102050.quest_desc: ["Wastes, crimson and warped forests, soul sand valley and basalt deltas. Each has its own mobs and sounds."],
	quest.0000000000102050.title: "Five Hells",
	quest.0000000000102060.quest_desc: ["Dark red brick corridors over the lava. Blazes, wither skeletons and nether wart grow here."],
	quest.0000000000102060.title: "Nether Fortress",
	quest.0000000000102070.quest_desc: ["A ghast fireball can be punched back with a bare hand or an arrow — that is how the achievement is earned. The tear is used in regeneration potions."],
	quest.0000000000102070.title: "Giant Baby",
	quest.0000000000102080.quest_desc: ["Blaze spawners are in the fortress towers. Bring a shield, a bow and something to stand behind. Rods are needed for the End and for brewing."],
	quest.0000000000102080.title: "Blazes",
	quest.0000000000102090.quest_desc: ["Wither skeletons drop a skull with roughly 2.5% chance. Looting III makes it much faster. You need three."],
	quest.0000000000102090.title: "Skulls",
	quest.00000000001020A0.quest_desc: ["Grows only on soul sand. Take a handful home: every potion starts with it."],
	quest.00000000001020A0.title: "Nether Wart",
	quest.00000000001020B0.quest_desc: ["Water bottle + nether wart + magma cream. Three minutes of swimming in lava. Brew a stack before the Wither fight."],
	quest.00000000001020B0.title: "Fire Resistance",
	quest.00000000001020C0.quest_desc: ["Orange glowing blocks in crimson forests, blue in warped ones. They light a base better than torches."],
	quest.00000000001020C0.title: "Shroomlights",
	quest.00000000001020D0.quest_desc: ["Skeletons here are fast and there are hundreds of them. Soul sand slows you down, soul soil does not — build paths from it."],
	quest.00000000001020D0.title: "Valley of Souls",
	quest.00000000001020E0.quest_desc: ["Nether gold ore gives nuggets even with a stone pickaxe. Nine nuggets make an ingot, and ingots make piglins friendly."],
	quest.00000000001020E0.title: "Nether Gold",
	quest.00000000001020F0.quest_desc: ["Throw a gold ingot at a piglin and wait. They pay with pearls, quartz, leather, and sometimes with the smithing template.", "Wear gold armor so they do not attack."],
	quest.00000000001020F0.title: "Barter",
	quest.0000000000102100.quest_desc: ["Black stone castles full of piglin brutes. They do not forgive gold theft. Loot the chests: the netherite upgrade template is here."],
	quest.0000000000102100.title: "Bastion Remnant",
	quest.0000000000102110.quest_desc: ["Hoglins attack on sight unless you stand in a warped forest. They drop leather and porkchops."],
	quest.0000000000102110.title: "Hoglin Hunt",
	quest.0000000000102120.quest_desc: ["Saddle a strider and steer with a warped fungus on a stick. Lava is their water."],
	quest.0000000000102120.title: "Ride the Strider",
	quest.0000000000102130.quest_desc: ["Hit one zombified piglin and every piglin within 32 blocks comes for you. Choose the moment carefully."],
	quest.0000000000102130.title: "Angry Crowd",
	quest.0000000000102140.quest_desc: ["Y=15, long tunnels every two blocks. Beds explode here and clear a large area — cheap mining, expensive sleep."],
	quest.0000000000102140.title: "Ancient Debris",
	quest.0000000000102150.quest_desc: ["Smelt debris in a furnace: four scrap and four gold make one netherite ingot."],
	quest.0000000000102150.title: "Netherite Scrap",
	quest.0000000000102160.quest_desc: ["The template is consumed on every upgrade, but it can be duplicated with diamonds and netherrack."],
	quest.0000000000102160.title: "Smithing Template",
	quest.0000000000102170.quest_desc: ["They do not burn in lava and mine faster than diamond."],
	quest.0000000000102170.title: "Netherite Tools",
	quest.0000000000102180.quest_desc: ["Four ingots per piece. Knockback resistance is the reason people grind for it."],
	quest.0000000000102180.title: "Netherite Armor",
	quest.0000000000102190.quest_desc: ["Found in bastions and ruined portals. Needed for the respawn anchor."],
	quest.0000000000102190.title: "Crying Obsidian",
	quest.00000000001021A0.quest_desc: ["Six crying obsidian and three glowstone. Charge with glowstone and use it — your spawn moves to the Nether."],
	quest.00000000001021A0.title: "Respawn Anchor",
	quest.00000000001021B0.quest_desc: ["A compass bound to a lodestone always points at it, in any dimension. Mark your portal."],
	quest.00000000001021B0.title: "Lodestone",
	quest.00000000001021C0.quest_desc: ["Four soul sand in a T, three skulls on top. Summon it in a long tunnel dug in the bedrock roof — the Wither cannot break through and you can shoot it from the side.", "Bring a bow with Power, golden apples and milk."],
	quest.00000000001021C0.title: "The Wither",
	quest.00000000001021D0.quest_desc: ["Three obsidian, five glass, one nether star. A pyramid of iron blocks underneath decides the radius and the effects."],
	quest.00000000001021D0.title: "Beacon",
	quest.00000000001021E0.quest_desc: ["A four-level pyramid: 164 blocks of iron, gold, diamond, emerald or netherite. All six effects at once."],
	quest.00000000001021E0.title: "Full Beacon",
	quest.00000000001021F0.quest_desc: ["Hold every status effect at the same time, including the bad ones. Beacon, potions, a witch and a pufferfish will help."],
	quest.00000000001021F0.title: "Whole Spectrum",
	quest.0000000000102200.quest_desc: ["A custom item of this pack: three netherite scrap around a token, three gold ingots underneath. The recipe is in JEI."],
	quest.0000000000102200.title: "Premium Token",
	quest.0000000000102210.quest_desc: ["Blaze powder plus an ender pearl. Take twelve: some of them break, and some will have to be thrown into the portal frame."],
	quest.0000000000102210.title: "Eyes of Ender",
	quest.0000000000102220.quest_desc: ["Throw an eye and follow it. When it starts going down, dig. The portal room is under the library."],
	quest.0000000000102220.title: "Stronghold",
	quest.0000000000102230.quest_desc: ["Food, blocks to bridge with, fireworks for the elytra later, and a bed you are NOT going to sleep in.", "Tick the box when the inventory is ready."],
	quest.0000000000102230.title: "Before the Fall",
	quest.0000000000103010.quest_desc: ["Jump into the starry portal. You appear on an obsidian platform; if it is broken, bring blocks.", "The dragon heals from the crystals on the pillars. Break them first."],
	quest.0000000000103010.title: "The End",
	quest.0000000000103020.quest_desc: ["Some crystals sit behind iron bars: dig up, or shoot through the gap. An exploded crystal hurts badly — keep distance."],
	quest.0000000000103020.title: "Obsidian Pillars",
	quest.0000000000103030.quest_desc: ["Shoot it in the wings when it circles, hit it with a sword when it sits on the fountain. Beds and anchors explode here too — some people kill it that way."],
	quest.0000000000103030.title: "The Ender Dragon",
	quest.0000000000103040.quest_desc: ["It teleports when hit. Put a piston next to it and power the piston, or place a torch two blocks below and break the block above."],
	quest.0000000000103040.title: "Dragon Egg",
	quest.0000000000103050.quest_desc: ["Use a glass bottle on the purple cloud the dragon leaves on the fountain, or on its fireball."],
	quest.0000000000103050.title: "Dragon Breath",
	quest.0000000000103060.quest_desc: ["Four end crystals on the exit portal bring the dragon back. It drops experience again and opens another gateway."],
	quest.0000000000103060.title: "Dragon Again",
	quest.0000000000103070.quest_desc: ["A small bedrock portal appears after the kill. Throw an ender pearl into it, or drink to fit through."],
	quest.0000000000103070.title: "The Gateway",
	quest.0000000000103080.quest_desc: ["Thousands of islands with chorus trees, end cities and ships. Bring blocks to bridge the gaps."],
	quest.0000000000103080.title: "Outer Islands",
	quest.0000000000103090.quest_desc: ["The fruit teleports you at random, the popped one is used for end rods and purpur. Bake it in a furnace."],
	quest.0000000000103090.title: "Chorus",
	quest.00000000001030A0.quest_desc: ["Here they are everywhere. A pumpkin on the head prevents eye contact; a two-block roof lets you fight safely."],
	quest.00000000001030A0.title: "Endermen of the End",
	quest.00000000001030B0.quest_desc: ["Get hit by a shulker bullet and float up 50 blocks without falling."],
	quest.00000000001030B0.title: "Levitation",
	quest.00000000001030C0.quest_desc: ["A copper spyglass and an amethyst shard. Look at the dragon through it during the fight."],
	quest.00000000001030C0.title: "Look Up",
	quest.00000000001030D0.quest_desc: ["Tall purple towers on the outer islands. The ship next to some of them carries exactly one thing you came for."],
	quest.00000000001030D0.title: "End City",
	quest.00000000001030E0.quest_desc: ["Their bullets levitate you. A shield blocks the bullet, and two shells make a shulker box."],
	quest.00000000001030E0.title: "Shulkers",
	quest.00000000001030F0.quest_desc: ["On the bow of the end ship, in an item frame. One pair per ship — and ships are far apart."],
	quest.00000000001030F0.title: "Wings",
	quest.0000000000103100.quest_desc: ["Jump, open the wings with the jump button, and boost with rockets made of paper and gunpowder."],
	quest.0000000000103100.title: "Flight",
	quest.0000000000103110.quest_desc: ["Two shells around a chest. It keeps its contents when broken — the best inventory in the game."],
	quest.0000000000103110.title: "Portable Chest",
	quest.0000000000103120.quest_desc: ["Purpur blocks and end rods are the building material of the cities. The dragon head sits on the bow of the ship, next to the elytra."],
	quest.0000000000103120.title: "Purple Stone",
	quest.0000000000103130.quest_desc: ["Everything that cannot be bought: the egg, the wings, the box and the star."],
	quest.0000000000103130.title: "Trophies",
	quest.0000000000103140.quest_desc: ["A custom item of this pack: two diamond blocks, two emerald blocks, two premium tokens and a nether star.", "Recipe is in JEI. Premium tokens are made in the Crimson Furnace chapter."],
	quest.0000000000103140.title: "Medal of the Master",
	quest.0000000000103150.quest_desc: ["Five hours of play and five hundred kills. The statistics are counted for the whole world, not for this chapter."],
	quest.0000000000103150.title: "Veteran",
	quest.0000000000103160.quest_desc: ["Three worlds, one book, every chapter closed. There is nothing left to tick — so tick this.", "Thanks for playing this pack."],
	quest.0000000000103160.title: "End of the Story",
	quest.0000000000104010.quest_desc: ["The Galosphere mod populated the depths: three cave biomes, two structures, the metal palladium, sterling armor, moles with pouches and something ancient under the salt. The way in is below the Deep Dark — dig even deeper and look for the pink glow.", "Every item of the mod is in JEI. This chapter walks you through all of it."],
	quest.0000000000104010.title: "Salt Breath",
	quest.0000000000104020.quest_desc: ["Salt in the caves comes in three colors: pink, rose and pastel. Mine whole blocks, not just shards — they will be needed for building."],
	quest.0000000000104020.title: "Three Shades of Salt",
	quest.0000000000104030.quest_desc: ["A pink salt lamp is crafted from shards, a chandelier hangs from the ceiling, and a light stand holds the floor. Soul versions are made with soul soil — the same recipes."],
	quest.0000000000104030.title: "Salt and Light",
	quest.0000000000104040.quest_desc: ["On the floor and ceiling of the salt caves grow pink salt straws — hollow crystal tubes. Break them and take a few: they look great in builds."],
	quest.0000000000104040.title: "Pink Straws",
	quest.0000000000104050.quest_desc: ["The salt caves are guarded by the Preserved — undead in salty bandages. They come in groups of four and drop nothing: the valuable things stay inside them. Or not."],
	quest.0000000000104050.title: "The Preserved",
	quest.0000000000104060.quest_desc: ["Somewhere in the salt caves there is a saline composter — throw a pink salt shard into it and get coarse dirt. The advancement \"Saline Solution\" will confirm it."],
	quest.0000000000104060.title: "Saline Solution",
	quest.0000000000104070.quest_desc: ["Craft bricks and polished salt — and the stairs, slabs and walls from them. The rest of the variants are cut in the stonecutter: any block of the family gives all the others."],
	quest.0000000000104070.title: "Salt Mason",
	quest.0000000000104080.quest_desc: ["The same set for the other two colors. Craft what you need, cut the rest in the stonecutter — and build yourself a salt palace."],
	quest.0000000000104080.title: "Rose and Pastel",
	quest.0000000000104090.quest_desc: ["The final set of salt blocks for the collector: all the slabs, stairs and walls of the rose and pastel families. Mine more salt and craft the rest — or cut it in the stonecutter."],
	quest.0000000000104090.title: "Salt Pantry",
	quest.00000000001040A0.quest_desc: ["The second biome of the depths: hanging gardens of lichen. Moss covers the floor, bowls of lichen hang on the walls — collect everything."],
	quest.00000000001040A0.title: "Lichen Gardens",
	quest.00000000001040B0.quest_desc: ["Walk across lichen moss — the soft green light under your feet gives the advancement \"Light the Way!\"."],
	quest.00000000001040B0.title: "Glowing Path",
	quest.00000000001040C0.quest_desc: ["Cordyceps grow in columns through the whole biome. Eat one while standing underwater — the advancement is called \"Edible Air\" for a reason. The golden version is crafted and fills you much better."],
	quest.00000000001040C0.title: "Edible Air",
	quest.00000000001040D0.quest_desc: ["Lichen shelves are the favorite food of spectres; roots decorate the walls, and vines are climbable — like ladders, but alive."],
	quest.00000000001040D0.title: "Shelves, Roots and Vines",
	quest.00000000001040E0.quest_desc: ["Spectres drift through the lichen caves — harmless ghostly birds that spawn on lichen moss. Lure one with an allurite shard or a lichen shelf, then catch it with an empty glass bottle: the advancement is called \"Watchfly?\"."],
	quest.00000000001040E0.title: "Spectre in a Bottle",
	quest.00000000001040F0.quest_desc: ["Give a spectre an allurite shard — it becomes bound. Now look at it through a spyglass and you will get the advancement \"Eye for an Eye\"... and something more."],
	quest.00000000001040F0.title: "Eye for an Eye",
	quest.0000000000104100.quest_desc: ["Spectres lay specterpillars — small crawling larvae. Frogs adore them: vanilla frog food, right from the mod."],
	quest.0000000000104100.title: "Caterpillars",
	quest.0000000000104110.quest_desc: ["A thrown flare of spectral light — the mod's own way to see what hides in the dark. Craft a few before long cave trips."],
	quest.0000000000104110.title: "Spectre Flare",
	quest.0000000000104120.quest_desc: ["The rarest and most beautiful biome of the mod: canyons overgrown with crystals. Allurite is blue, lumiere glows yellow-green, opal shimmers with all colors. Large palladium veins are only here."],
	quest.0000000000104120.title: "Crystal Canyons",
	quest.0000000000104130.quest_desc: ["Nine shards make a block. Allurite blocks have a secret: they muffle sound waves — sculk sensors through them do not hear you."],
	quest.0000000000104130.title: "Blocks and Clusters",
	quest.0000000000104140.quest_desc: ["A lamp for each crystal: allurite, lumiere and even amethyst — the mod gives vanilla amethyst bricks, slabs, stairs and a lamp."],
	quest.0000000000104140.title: "Crystal Light",
	quest.0000000000104150.quest_desc: ["Sparkles flit over calcite and crystal blocks in the canyons. They breathe underwater, love glow lichen and pollinate the crystals — that is why the canyons bloom."],
	quest.0000000000104150.title: "Sparkles",
	quest.0000000000104160.quest_desc: ["A glow flare lights up the cave where it lands. Better than torches: throw it ahead of you into the dark."],
	quest.0000000000104160.title: "Light the Way!",
	quest.0000000000104170.quest_desc: ["Insert a lumiere shard as fuel — and the device will tell you that monsters are near. Lumiere shards also work as fuel for the echo bell... the mod loves lumiere."],
	quest.0000000000104170.title: "Monstrometer",
	quest.0000000000104180.quest_desc: ["Somewhere in the depths there is a lumiere composter — a lumiere shard in it turns into glowstone dust. The advancement \"Fragility of Light\" will confirm it."],
	quest.0000000000104180.title: "Fragility of Light",
	quest.0000000000104190.quest_desc: ["Bricks, smooth blocks and chiseled variants for allurite and lumiere. Slabs, stairs and the rest — in the stonecutter."],
	quest.0000000000104190.title: "Crystal Mason",
	quest.00000000001041A0.quest_desc: ["The same for opal and modded amethyst. Opal bricks even have walls. Everything else — stonecutter."],
	quest.00000000001041A0.title: "Opal and Amethyst",
	quest.00000000001041B0.quest_desc: ["The metal of the depths. Small veins are everywhere in the Overworld from the bedrock up to Y=48, large ones — only in the crystal canyons up to Y=112. A stone pickaxe is enough. Smelt the raw ore into ingots."],
	quest.00000000001041B0.title: "Palladium",
	quest.00000000001041C0.quest_desc: ["A palladium block is a valid beacon base — the mod quietly gives you a cheap pyramid. Nuggets, dust, lattice (glow berries hang on it), panels and tiles round out the family."],
	quest.00000000001041C0.title: "Palladium Blocks",
	quest.00000000001041D0.quest_desc: ["The full sterling set: crafted from palladium, repaired with palladium ingots, protects from freezing. The pride of one who has mastered the depths."],
	quest.00000000001041D0.title: "Sterling Armor",
	quest.00000000001041E0.quest_desc: ["A sterling helmet can hold a banner — attach any and wear it with pride. The advancement is called \"Looking Good Partner!\"."],
	quest.00000000001041E0.title: "Looking Good, Partner!",
	quest.00000000001041F0.quest_desc: ["Sterling horse armor is crafted like the rest — and it does not sink in water. Put it on a horse with a banner: the mod has an advancement for that too."],
	quest.00000000001041F0.title: "Fancy Seeing You Here!",
	quest.0000000000104200.quest_desc: ["A thrown bomb blasts stone. It can be tuned in the crafting grid: slime ball makes it bounce, string lengthens the fuse, gunpowder makes the blast stronger."],
	quest.0000000000104200.title: "Palladium Bomb",
	quest.0000000000104210.quest_desc: ["Fat blind moles dig through the salt caves. They fear alliums — plant one and the mole will not come near. Watch one at work."],
	quest.0000000000104210.title: "Moles of the Depths",
	quest.0000000000104220.quest_desc: ["Moles dig burrows — dig one up with a shovel and take it with you. Tuff dirt is crafted and moles happily dig it too."],
	quest.0000000000104220.title: "Mole Burrow",
	quest.0000000000104230.quest_desc: ["Every time a mole returns home, the burrow gets a new mining pouch. Put a pouch into the burrow — and the mole will start taking orders: it asks for dirt, ores, salt... and brings gifts in return. Gifts are random: tuff and torches, rarely — bombs, opal flakes and a broken bell, epically — golden apples, enchanted books, the trim \"Faith\" and maps to the ruins."],
	quest.0000000000104230.title: "Mining Pouch",
	quest.0000000000104240.quest_desc: ["A rare gift from the moles. Needed for the next quest — wait for the burrow to give you a couple."],
	quest.0000000000104240.title: "Opal Flakes",
	quest.0000000000104250.quest_desc: ["Hit any sapling with opal flakes in hand — it turns into an opal sapling. Plant it and grow an opal tree: shimmering leaves and opal logs."],
	quest.0000000000104250.title: "Opal Trees",
	quest.0000000000104260.quest_desc: ["The mod generates forgotten ruins along rivers, in mountains, hills and taiga — ancient buildings of stone and tuff. Inside there is suspicious gravel, and in it — new sherds and sometimes an enchanted book with \"Sifting\"."],
	quest.0000000000104260.title: "Forgotten Ruins",
	quest.0000000000104270.quest_desc: ["Brush the suspicious gravel in the ruins: the mod adds two sherds — \"Thirst\" and \"Wave\". They go on a decorated pot like vanilla ones. And you can brush the same block again — there is an advancement for that."],
	quest.0000000000104270.title: "Thirst and Wave",
	quest.0000000000104280.quest_desc: ["An epic gift from the moles — the smithing template \"Faith\". Apply it to any armor at the smithing table with any trim material."],
	quest.0000000000104280.title: "Trim \"Faith\"",
	quest.0000000000104290.quest_desc: ["Throw the dart — it sticks and reels the loot or an unlucky mob straight to you. The fisherman's rod of the underground."],
	quest.0000000000104290.title: "Rope Dart",
	quest.00000000001042A0.quest_desc: ["A magic weapon of the mod: charges up and fires a salt volley, then recharges. Can be enchanted like a bow. Illagers hate it."],
	quest.00000000001042A0.title: "Saltbound Tablet",
	quest.00000000001042B0.quest_desc: ["Find an evoker — in a woodland mansion or during a raid — and finish him with the saltbound tablet. The mod has a personal advancement for exactly this kill."],
	quest.00000000001042B0.title: "Finally a Worthy Opponent",
	quest.00000000001042C0.quest_desc: ["The workbench of the depths — crafted from salt and crystals. Looks great in a cave base and opens its own window."],
	quest.00000000001042C0.title: "Combustion Table",
	quest.00000000001042D0.quest_desc: ["A weapon rack holds your swords and pickaxes like a museum exhibit; a shadow frame darkens the walls; gilded beads tinkle quietly. All of it is crafted."],
	quest.00000000001042D0.title: "Decor of the Depths",
	quest.00000000001042E0.quest_desc: ["Phantom membranes are cured with salt — they stop being slippery and become a building material: membranes, membrane blocks and \"stranded\" blocks."],
	quest.00000000001042E0.title: "Cured Membrane",
	quest.00000000001042F0.quest_desc: ["The personal teleport of the mod — crafted from salt and crystals. How exactly it anchors to the burrow — find out yourself, the mod does not like spoilers."],
	quest.00000000001042F0.title: "Burrow Anchor",
	quest.0000000000104300.quest_desc: ["Only in the pink salt caves the mod generates a shrine of salt — a quiet hall with an echo altar in the center, chests with jerky, leather, membranes, sometimes a name tag and a golden apple, and a library with books."],
	quest.0000000000104300.title: "Shrine of Salt",
	quest.0000000000104310.quest_desc: ["A broken echo bell is brought by moles (one you already have). Craft the whole bell: broken bell, two echo shards from an ancient city, an allurite shard and a stick. Insert an allurite charge — and the bell will ring near ores. Except ancient debris: that one it does not hear."],
	quest.0000000000104310.title: "Echo Bell",
	quest.0000000000104320.quest_desc: ["Return to the shrine. Ring the charged bell at the echo altar in the center of the hall — and the Berserker wakes up. He smashes the ground, shakes off debris, pierces with salt pillars and summons the Preserved. Bring good armor."],
	quest.0000000000104320.title: "Reign of Terror",
	quest.0000000000104330.quest_desc: ["Survive his reign and put him down. The Berserker drops a preserved template and preserved flesh — the flesh is edible, the template is for the smithing table."],
	quest.0000000000104330.title: "Berserker Slayer",
	quest.0000000000104340.quest_desc: ["At the smithing table: preserved template + any tool, armor or shulker box + pink salt shard. The thing becomes preserved — the depths respect such things."],
	quest.0000000000104340.title: "Preserved Upgrade",
	quest.0000000000104350.quest_desc: ["You have seen all three biomes and both structures, raised sterling armor, befriended the moles, woken up and put down the Berserker. The depths are yours."],
	quest.0000000000104350.title: "Master of the Galosphere",
	quest.0000000000105010.quest_desc: ["Eternal Starlight opens the Eternal Starlight dimension: night, auroras and 24 biomes.", "The portal is not built from blocks - it is opened by the orb of prophecy. Get it and step through the stars."],
	quest.0000000000105010.title: "A Sky of a Million Stars",
	quest.0000000000105020.quest_desc: ["Others were here before you: portal ruins are scattered across the Starlight, from snows to jungles.", "Inside - chests with dusted shards and hints of those who never returned."],
	quest.0000000000105020.title: "Ruins of the Gates",
	quest.0000000000105030.quest_desc: ["The first twelve biomes: from starlight forest to icy sea.", "A compass is useless here - navigate by the glow."],
	quest.0000000000105030.title: "Cartographer of Light I",
	quest.0000000000105040.quest_desc: ["The remaining biomes, including the Abyss: nothing in the Starlight is darker.", "Something lives in the Abyss that makes this chapter worth finishing."],
	quest.0000000000105040.title: "Cartographer of Light II",
	quest.0000000000105050.quest_desc: ["Three major structures: the golem forge (where starlight golems are born), the cursed garden and the stranghoul den.", "In the forge look for energy blocks: deactivate them and the golem becomes vulnerable."],
	quest.0000000000105050.title: "Forge of the Legion",
	quest.0000000000105060.quest_desc: ["The seas of the Starlight only look calm. Seven woods - seven boats and chest boats.", "The starlit sea is faster to cross than to walk around."],
	quest.0000000000105060.title: "The Flotilla",
	quest.0000000000105070.quest_desc: ["Ten creatures without which the Starlight would be just an empty night.", "The crystallized moth can be tamed with meat: it strikes with a sound wave."],
	quest.0000000000105070.title: "Local Fauna",
	quest.0000000000105080.quest_desc: ["Creteors fall from the sky during meteor showers, the permafrost spits from afar, the stranghoul hunts at night.", "The stranghoul, by the way, can be hired with a bowl of spicy stew - for one day."],
	quest.0000000000105080.title: "Dangerous Neighbours",
	quest.0000000000105090.quest_desc: ["The tangled, its husk and skull: the tenacious vine does not let go even of the dead.", "The skull explodes - you can chain it (and get the mod achievement)."],
	quest.0000000000105090.title: "A Tangled Death",
	quest.00000000001050A0.quest_desc: ["First boss: the Gatekeeper tests the worthy. He hurls fireballs and tolerates no weakling.", "Pass his challenge - and take what he guards."],
	quest.00000000001050A0.title: "The Gatekeeper",
	quest.00000000001050B0.quest_desc: ["The second boss waits in the Abyss. Ignite it - only fire makes it vulnerable.", "Breath and thorns fly in arcs: keep your distance and do not stand in the pools."],
	quest.00000000001050B0.title: "The Lunar Monstrosity",
	quest.00000000001050C0.quest_desc: ["Four golems: grimstone (summoned with a carved cactus), starlight, astral and aethersent.", "Deactivate or freeze the starlight one first - otherwise its armour shrugs off damage."],
	quest.00000000001050C0.title: "Wardens of Stone and Steel",
	quest.00000000001050D0.quest_desc: ["Twelve materials every Starlight kit begins with.", "Starfire is not mined: help the starfire birds nest - and they will share."],
	quest.00000000001050D0.title: "First Tears",
	quest.00000000001050E0.quest_desc: ["Glacite, deepsilver, unrealium, aethersent, golem steel and flowglaze (starfire thrown into sand).", "The alloy furnace smelts what a normal one cannot; the crystalborn catalyst runs on crystals."],
	quest.00000000001050E0.title: "Ingots and Alloys",
	quest.00000000001050F0.quest_desc: ["The first two tiers: thermal springstone (careful: giant plants burn only with fire) and glacite.", "Scythes mow grass in bundles, the glacite shield holds the blow."],
	quest.00000000001050F0.title: "Springstone and Glacite · I",
	quest.0000000000105100.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105100.title: "Springstone and Glacite · II",
	quest.0000000000105110.quest_desc: ["The malarite spear outreaches a sword, sickles cut ears, the deepsilver brush is for archaeologists.", "Silver does not tarnish in the dusk - check what glitters in your hand."],
	quest.0000000000105110.title: "Malarite and Deepsilver",
	quest.0000000000105120.quest_desc: ["Starlit diamond is harder than diamond; unrealium is lighter than shadow and hits harder.", "A full unrealium set is the mod achievement \"Step into the unknown\"."],
	quest.0000000000105120.title: "Starlit Diamond and Unrealium · I",
	quest.0000000000105130.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105130.title: "Starlit Diamond and Unrealium · II",
	quest.0000000000105140.quest_desc: ["The crafting peak: starfire and flowglaze gear plus smithing upgrade templates.", "Amaramber is got by hewing torreya logs: its chestplate glows from within."],
	quest.0000000000105140.title: "Starfire and Flowglaze · I",
	quest.0000000000105150.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105150.title: "Starfire and Flowglaze · II",
	quest.0000000000105160.quest_desc: ["The dagger of hunger devours foes, the bow of blood drinks life, the gravity pickaxe pulls ore itself.", "Every unique weapon has its own temper - try all twenty-seven."],
	quest.0000000000105160.title: "Unique Arms · I",
	quest.0000000000105170.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105170.title: "Unique Arms · II",
	quest.0000000000105180.quest_desc: ["Seven arrow kinds: from glacite to voracious. The galactic quiver holds them all.", "The aethersent arrow glows in flight - handy in a night that never ends."],
	quest.0000000000105180.title: "Arrows and a Quiver",
	quest.0000000000105190.quest_desc: ["The aethersent cape, the alchemist robe, air sac boots and four trim patterns.", "Air boots soften the fall: the Abyss becomes a little kinder."],
	quest.0000000000105190.title: "The Raiment",
	quest.00000000001051A0.quest_desc: ["Everything edible in the Starlight on one table: from lunar berries to bouldershroom stew.", "Spicy millet gives numbness - it absorbs damage. Bouldershroom stew lets you climb cliffs."],
	quest.00000000001051A0.title: "The Star Kitchen · I",
	quest.00000000001051B0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001051B0.title: "The Star Kitchen · II",
	quest.00000000001051C0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001051C0.title: "The Star Kitchen · III",
	quest.00000000001051D0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001051D0.title: "The Star Kitchen · IV",
	quest.00000000001051E0.quest_desc: ["Pocket miracles: amulets, pendants, bombs and the orb of prophecy once more - now as a trophy.", "The aetherstrike rocket calls a meteor shower. Make a wish."],
	quest.00000000001051E0.title: "Amulets and Curios · I",
	quest.00000000001051F0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001051F0.title: "Amulets and Curios · II",
	quest.0000000000105200.quest_desc: ["24 discs are hidden in structure chests and boss pockets.", "A jukebox in your overworld home is the best way to remember the stars."],
	quest.0000000000105200.title: "Music of the Spheres · I",
	quest.0000000000105210.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105210.title: "Music of the Spheres · II",
	quest.0000000000105220.quest_desc: ["Full building sets of the first two woods: from log to sign.", "Northland wood smells of pine and snow - check with your nose."],
	quest.0000000000105220.title: "Lunar and Northland · I",
	quest.0000000000105230.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105230.title: "Lunar and Northland · II",
	quest.0000000000105240.quest_desc: ["Banyin bends, scarlet burns with colour: both beg into an interior.", "Scarlet leaves fold into piles - a soft floor for a greenhouse."],
	quest.0000000000105240.title: "Banyin and Scarlet · I",
	quest.0000000000105250.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105250.title: "Banyin and Scarlet · II",
	quest.0000000000105260.quest_desc: ["Three late woods plus torreya tiles, campfire and vines.", "Jinglestem rings in the wind: a raft of it is music on the road."],
	quest.0000000000105260.title: "Torreya, Jinglestem, Cradlewood · I",
	quest.0000000000105270.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105270.title: "Torreya, Jinglestem, Cradlewood · II",
	quest.0000000000105280.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105280.title: "Torreya, Jinglestem, Cradlewood · III",
	quest.0000000000105290.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.0000000000105290.title: "Torreya, Jinglestem, Cradlewood · IV",
	quest.00000000001052A0.quest_desc: ["The building family \"Мракокамень и бездносланец\": every slab, stair and wall of the set.", "A full set = not a single block of the family is lost."],
	quest.00000000001052A0.title: "Мракокамень и бездносланец · I",
	quest.00000000001052B0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001052B0.title: "Мракокамень и бездносланец · II",
	quest.00000000001052C0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001052C0.title: "Мракокамень и бездносланец · III",
	quest.00000000001052D0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001052D0.title: "Мракокамень и бездносланец · IV",
	quest.00000000001052E0.quest_desc: ["The building family \"Пустокамень, радианит и прочие\": every slab, stair and wall of the set.", "A full set = not a single block of the family is lost."],
	quest.00000000001052E0.title: "Пустокамень, радианит и прочие · I",
	quest.00000000001052F0.quest_desc: ["Continuation of the set: not a single block or item of the theme is lost."],
	quest.00000000001052F0.title: "Пустокамень, радианит и прочие · II",
