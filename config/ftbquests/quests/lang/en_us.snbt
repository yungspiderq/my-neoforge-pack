{
	"chapter.7100000100000000.chapter_subtitle": [
		"Every world begins with a small decision. Gather, adapt, build.",
		"Constellation layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000100000000.title": "The First Spark",
	"chapter.7100000200000000.chapter_subtitle": [
		"Turn survival into a home. Craft workstations and make a place worth returning to.",
		"City layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000200000000.title": "The Living Homestead",
	"chapter.7100000300000000.chapter_subtitle": [
		"Go deeper. The ground hides everything your future factories need.",
		"Mountain layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000300000000.title": "Beneath the Stone",
	"chapter.7100000400000000.chapter_subtitle": [
		"You cannot build great machines on an empty stomach.",
		"Islands layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000400000000.title": "Harvest and Hearth",
	"chapter.7100000500000000.chapter_subtitle": [
		"Build with care. Every material is a new design language.",
		"Spiral layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000500000000.title": "City of One",
	"chapter.7100000600000000.chapter_subtitle": [
		"Let nature become your guide. Explore the living world.",
		"Gear layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000600000000.title": "The Wild Compass",
	"chapter.7100000700000000.chapter_subtitle": [
		"Before industry comes logic. Route power with dust, pulses and pistons.",
		"Metro layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000700000000.title": "Redstone Awakening",
	"chapter.7100000800000000.chapter_subtitle": [
		"The seas conceal rare treasures and ancient technology.",
		"Wave layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000800000000.title": "The Deep Atlas",
	"chapter.7100000900000000.chapter_subtitle": [
		"Learn what glows, brews, enchants and transforms.",
		"Orbit layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000900000000.title": "The Arcane Workshop",
	"chapter.7100000A00000000.chapter_subtitle": [
		"Behind the portal, heat becomes a resource.",
		"Factory layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000A00000000.title": "Through the Fire",
	"chapter.7100000B00000000.chapter_subtitle": [
		"Reach the quiet dimension and bring its stories home.",
		"Rail layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000B00000000.title": "Beyond the Horizon",
	"chapter.7100000C00000000.chapter_subtitle": [
		"Power has shape: shafts, gears and rotations. Build your first workshop.",
		"Staircase layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000C00000000.title": "Create: Foundations",
	"chapter.7100000D00000000.chapter_subtitle": [
		"Make motion meaningful. Turn simple gears into moving structures.",
		"Constellation layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000D00000000.title": "Create: Moving Cities",
	"chapter.7100000E00000000.chapter_subtitle": [
		"From brass to automation. Design a factory with a mind of its own.",
		"City layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000E00000000.title": "Create: The Grand Factory",
	"chapter.7100000F00000000.chapter_subtitle": [
		"Meet specialists, develop a marketplace and earn a village's trust.",
		"City layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100000F00000000.title": "Village of Trades",
	"chapter.7100001000000000.chapter_subtitle": [
		"Brush away centuries of dust and reconstruct forgotten histories.",
		"Spiral layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001000000000.title": "Dust and Relics",
	"chapter.7100001100000000.chapter_subtitle": [
		"Listen to the stone. In the darkness every sound matters.",
		"Orbit layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001100000000.title": "The Silent Depths",
	"chapter.7100001200000000.chapter_subtitle": [
		"Follow the maps of travellers and write your own route.",
		"Constellation layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001200000000.title": "Atlas of Horizons",
	"chapter.7100001300000000.chapter_subtitle": [
		"Master great heights and turn the sky into a playground for builders.",
		"Mountain layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001300000000.title": "Above the Clouds",
	"chapter.7100001400000000.chapter_subtitle": [
		"Route packages, separate materials and keep the workshop supplied.",
		"Metro layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001400000000.title": "Create: Sorting Networks",
	"chapter.7100001500000000.chapter_subtitle": [
		"Design railways and build a network connecting your outposts.",
		"Rail layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001500000000.title": "Create: Iron Roads",
	"chapter.7100001600000000.chapter_subtitle": [
		"Turn stored heat into smooth mechanical power.",
		"Gear layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001600000000.title": "Create: Steam Age",
	"chapter.7100001700000000.chapter_subtitle": [
		"Attach a purpose to movement. Make mechanisms solve real problems.",
		"Islands layout: explore multiple routes, then claim the chapter seal."
	],
	"chapter.7100001700000000.title": "Create: Moving Worlds",
	"chapter.7100001800000000.chapter_subtitle": [
		"Your world is now a machine. Prove you can combine every discipline.",
